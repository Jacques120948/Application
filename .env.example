# ── Base de données ────────────────────────────────────────────────────────────
# Rôle applicatif : ne doit être ni propriétaire des tables ni BYPASSRLS.
DATABASE_URL="postgresql://appforge_app:change_me@localhost:5432/appforge_dev"
# Rôle de migration : propriétaire des tables, utilisé uniquement par prisma migrate.
DIRECT_DATABASE_URL="postgresql://appforge:change_me@localhost:5432/appforge_dev"

# ── Sécurité ──────────────────────────────────────────────────────────────────
# 32 octets en base64. Générer avec : openssl rand -base64 32
SESSION_SECRET="remplacer-par-une-valeur-aleatoire-de-32-octets"
ENCRYPTION_KEY="remplacer-par-une-valeur-aleatoire-de-32-octets"

# ── IA ────────────────────────────────────────────────────────────────────────
# Sans clé, la plateforme fonctionne en mode hors ligne documenté (voir README).
ANTHROPIC_API_KEY=""

# ── Application ───────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NODE_ENV="development"
