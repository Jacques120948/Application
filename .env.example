# ── Base de données ────────────────────────────────────────────────────────────
# Rôle applicatif : ne doit être ni propriétaire des tables ni BYPASSRLS.
DATABASE_URL="postgresql://appforge_app:change_me@localhost:5432/appforge_dev"
# Rôle de migration : propriétaire des tables, utilisé uniquement par prisma migrate.
DIRECT_DATABASE_URL="postgresql://appforge:change_me@localhost:5432/appforge_dev"

# ── Sécurité ──────────────────────────────────────────────────────────────────
# 32 octets en base64. Générer avec : openssl rand -base64 32
SESSION_SECRET="remplacer-par-une-valeur-aleatoire-de-32-octets"
ENCRYPTION_KEY="remplacer-par-une-valeur-aleatoire-de-32-octets"

# ── IA ────────────────────────────────────────────────────────────────────────
# Sans clé, la plateforme fonctionne en mode hors ligne documenté (voir README).
ANTHROPIC_API_KEY=""

# ── Accès ─────────────────────────────────────────────────────────────────────
# Facultatif. Renseigné, l'inscription exige ce code : utile pour mettre la plateforme
# en ligne pour un test privé sans que quiconque puisse créer un compte.
SIGNUP_CODE=""

# ── Application ───────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Moteur social (Postelya) ──────────────────────────────────────────────────
# Sans ces deux valeurs, la préparation du lancement se présente comme non activée :
# aucun écran ne laisse croire qu'une fonction existe alors qu'elle n'est pas joignable.
# Le secret doit être identique côté Postelya. Générer avec : openssl rand -base64 32
SOCIAL_ENGINE_URL=""
SOCIAL_ENGINE_SECRET=""

# ── Paiement (Stripe) ─────────────────────────────────────────────────────────
# Sans clé secrète, aucun paiement n'est proposé : la page des offres le dit, et les
# routes de paiement répondent « introuvable ». Un seul compte Stripe, celui d'Evoliia ;
# les créateurs relient le leur par Stripe Connect (comptes standard).
STRIPE_SECRET_KEY=""
# Secret de signature du webhook « compte » (abonnements Evoliia) : /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""
# Secret de signature du webhook « comptes connectés » (ventes des créateurs) :
# /api/stripe/webhook/connect
STRIPE_CONNECT_WEBHOOK_SECRET=""
# Commission d'Evoliia sur les ventes des créateurs, en pour cent (0 à 30). Zéro par défaut.
STRIPE_APPLICATION_FEE_PERCENT="0"
