# ── Base de données ────────────────────────────────────────────────────────────
# Rôle applicatif : ne doit être ni propriétaire des tables ni BYPASSRLS.
DATABASE_URL="postgresql://appforge_app:change_me@localhost:5432/appforge_dev"
# Rôle de migration : propriétaire des tables, utilisé uniquement par prisma migrate.
DIRECT_DATABASE_URL="postgresql://appforge:change_me@localhost:5432/appforge_dev"

# ── Sécurité ──────────────────────────────────────────────────────────────────
# 32 octets en base64. Générer avec : openssl rand -base64 32
SESSION_SECRET="remplacer-par-une-valeur-aleatoire-de-32-octets"
ENCRYPTION_KEY="remplacer-par-une-valeur-aleatoire-de-32-octets"

# ── IA ────────────────────────────────────────────────────────────────────────
# Sans clé, la plateforme fonctionne en mode hors ligne documenté (voir README).
ANTHROPIC_API_KEY=""

# Clé Google AI d'Evoliia, pour créer des images au nom des créateurs (Nano Banana).
# Absente, la fonction est simplement éteinte : le créateur garde la voie de sa propre clé,
# et rien n'échoue. Présente, elle n'ouvre encore rien — chaque offre doit recevoir son
# quota d'images depuis le back-office, à zéro par défaut, parce que c'est Evoliia qui paie.
GEMINI_API_KEY=""

# ── Accès ─────────────────────────────────────────────────────────────────────
# Facultatif. Renseigné, l'inscription exige ce code : utile pour mettre la plateforme
# en ligne pour un test privé sans que quiconque puisse créer un compte.
SIGNUP_CODE=""

# ── Application ───────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Connexions publicitaires et Search Console ────────────────────────────────
# Sans ces identifiants, le connecteur concerné se présente comme « à venir » et sa route
# d'autorisation répond « introuvable ». Une porte fermée ne s'annonce pas : mieux vaut cela
# qu'un bouton qui mène à une page d'erreur du fournisseur.
#
# Les secrets ne quittent jamais le serveur. Ils ne servent qu'à échanger un code contre un
# jeton, de serveur à serveur, et n'ouvrent rien par eux-mêmes : c'est la personne qui
# autorise, compte par compte.

# Google — une seule application couvre Search Console et Google Ads.
# Adresse de retour à déclarer chez Google : <APP_URL>/api/connexions/google/retour
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Meta — Facebook et Instagram, pour MIRA.
# Adresse de retour à déclarer chez Meta : <APP_URL>/api/connexions/meta/retour
META_APP_ID=""
META_APP_SECRET=""
# Identifiant de configuration « Facebook Login for Business », relevé dans la console Meta.
# Toute application créée aujourd'hui à partir du cas d'usage « API Marketing » en reçoit une :
# les autorisations y vivent, et la personne y choisit les comptes publicitaires qu'elle confie.
# Absent, le connecteur retombe sur la connexion classique, qui reste valable pour les
# applications plus anciennes.
META_LOGIN_CONFIG_ID=""
# Facultatif. Meta maintient chaque version environ deux ans ; la relever est une variable
# plutôt qu'un déploiement, précisément pour qu'une version retirée ne casse rien en silence.
META_API_VERSION="v23.0"

# ── Moteur social (Postelya) ──────────────────────────────────────────────────
# Sans ces deux valeurs, la préparation du lancement se présente comme non activée :
# aucun écran ne laisse croire qu'une fonction existe alors qu'elle n'est pas joignable.
# Le secret doit être identique côté Postelya. Générer avec : openssl rand -base64 32
SOCIAL_ENGINE_URL=""
SOCIAL_ENGINE_SECRET=""

# ── Paiement (Stripe) ─────────────────────────────────────────────────────────
# Sans clé secrète, aucun paiement n'est proposé : la page des offres le dit, et les
# routes de paiement répondent « introuvable ». Un seul compte Stripe, celui d'Evoliia ;
# les créateurs relient le leur par Stripe Connect (comptes standard).
STRIPE_SECRET_KEY=""
# Secret de signature du webhook « compte » (abonnements Evoliia) : /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""
# Secret de signature du webhook « comptes connectés » (ventes des créateurs) :
# /api/stripe/webhook/connect
STRIPE_CONNECT_WEBHOOK_SECRET=""
# Commission d'Evoliia sur les ventes des créateurs, en pour cent (0 à 30). Zéro par défaut.
STRIPE_APPLICATION_FEE_PERCENT="0"

# Adresse publique de Postelya, vers laquelle pointe la section « Réseaux sociaux ».
# Sans elle, l'adresse actuelle est utilisée.
POSTELYA_URL=https://postelya.vercel.app
