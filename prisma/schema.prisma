// Modèle de données AppForge.
// Trois domaines : plateforme, projets, runtime des applications générées.
// Voir docs/03-modele-de-donnees.md

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────────── Plateforme ──────────────────────────────────

/// Où sert la connexion. La distinction est structurante : une connexion « EVOLIIA » sert
/// au créateur pendant qu'il construit, une connexion « APP » servira à son application une
/// fois en ligne. Les deux ne vivent pas la même vie et ne se révoquent pas ensemble.
enum IntegrationTarget {
  EVOLIIA
  APP
}

enum IntegrationStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

/// Comment le fournisseur nous autorise. OAuth quand il le propose ; clé fournie par le
/// créateur seulement quand aucun OAuth n'existe et que le fournisseur l'autorise.
enum CredentialKind {
  OAUTH
  API_KEY
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String
  name            String?
  locale          String    @default("fr")
  role            UserRole  @default(USER)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  disabledAt      DateTime?
  /// Alertes du Radar : nouvelles opportunités correspondant au profil.
  radarAlerts     Boolean   @default(true)
  /// Alertes de Lia : question qui revient, ticket ouvert, question sans réponse.
  supportAlerts   Boolean   @default(true)
  /// Client Stripe correspondant, créé au premier paiement.
  stripeCustomerId String?  @unique

  sessions             Session[]
  projects             Project[]
  connections          IntegrationConnection[]
  integrationEvents    IntegrationEvent[]
  marketingKits        MarketingKit[]
  medias               MediaAsset[]
  agentNotes           AgentNote[]
  radarRuns            RadarRun[]
  radarFeedback        RadarFeedback[]
  radarSignals         RadarSignal[]
  supportSettings      SupportSettings[]
  supportKnowledge     SupportKnowledgeEntry[]
  supportConversations SupportConversation[]
  supportTickets       SupportTicket[]
  supportInsights      SupportInsight[]
  notifications        Notification[]
  profile              CreatorProfile?
  ideas                Idea[]
  tokens               VerificationToken[]
  subscription         Subscription?
  wallet               CreditWallet?
  creditEntries        CreditLedger[]
  aiUsage              AiUsage[]
  chatMessages         ChatMessage[]

  @@index([createdAt])
}

/// Session du studio. Le jeton n'est jamais stocké en clair.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model VerificationToken {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  tokenHash  String       @unique
  purpose    TokenPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/// Offre commerciale de la plateforme. Modifiable depuis l'administration (exigence 34).
/// Réglages de l'installation, modifiables depuis le back-office sans redéploiement.
/// Table clé/valeur volontairement simple : les réglages sont rares et hétérogènes.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Plan {
  id                       String   @id
  name                     String
  description              String
  priceCents               Int
  currency                 String   @default("EUR")
  interval                 String   @default("month")
  maxProjects              Int
  /// Connexions externes autorisées. Modifiable depuis le back-office, comme le reste.
  maxConnections           Int      @default(0)
  /// Fonctions ouvertes par cette offre, par identifiant (voir server/billing/features.ts).
  /// Source de vérité des droits : le code ne décide jamais d'après le nom de l'offre.
  features                 String[] @default([])
  /// Espace d'images autorisé, en octets. Borne la seule dépense qui grandirait sinon
  /// avec l'usage plutôt qu'avec le nombre de clients.
  storageBytes             Int      @default(0)
  /// Quotas mensuels des deux modules. Réglables depuis le back-office, comme le reste.
  radarRunsPerMonth        Int      @default(1)
  liaAnswersPerMonth       Int      @default(0)
  liaConversationsPerMonth Int      @default(0)
  monthlyCredits           Int
  allowExport              Boolean  @default(false)
  allowCustomDomain        Boolean  @default(false)
  allowMobilePrep          Boolean  @default(false)
  /// Permet de générer réellement une application. L'offre gratuite s'arrête avant.
  allowBuild               Boolean  @default(true)
  /// Mise en avant dans la grille tarifaire.
  isRecommended            Boolean  @default(false)
  isActive                 Boolean  @default(true)
  sortOrder                Int      @default(0)
  /// Produit et tarif Stripe, créés à la demande. L'empreinte dit pour quel prix, quelle
  /// monnaie et quelle période le tarif a été créé.
  stripeProductId          String?
  stripePriceId            String?
  stripePriceFingerprint   String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @unique @db.Uuid
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  /// Résiliation demandée : l'offre reste active jusqu'à la fin de la période payée.
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([stripeSubscriptionId])
}

/// Un événement Stripe reçu. Retenu pour n'être traité qu'une fois. Table globale.
model StripeEvent {
  id         String   @id
  type       String
  account    String?
  receivedAt DateTime @default(now())
}

/// Solde de crédits IA. Cache : la vérité est la somme de CreditLedger.
/// Connexion d'un créateur à un service externe.
///
/// Aucun secret ici : cette table est lue pour afficher la liste des connexions, et cette
/// lecture ne doit jamais approcher un jeton. Les secrets vivent dans IntegrationCredential.
model IntegrationConnection {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  /// Identifiant du fournisseur dans le catalogue applicatif, par exemple "google-drive".
  providerId     String
  target         IntegrationTarget @default(EVOLIIA)
  /// Projet concerné, quand la connexion sert une application précise.
  projectId      String?           @db.Uuid
  status         IntegrationStatus @default(CONNECTED)
  /// Autorisations réellement accordées par le fournisseur, telles qu'il les a renvoyées.
  scopes         String[]          @default([])
  /// Compte distant, affiché au créateur pour qu'il sache ce qu'il a connecté.
  accountLabel   String?
  connectedAt    DateTime          @default(now())
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  /// Dernière erreur, en clair et sans secret : « autorisation refusée », « quota dépassé ».
  lastError      String?
  disconnectedAt DateTime?
  updatedAt      DateTime          @updatedAt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  credential IntegrationCredential?
  events     IntegrationEvent[]

  @@unique([userId, providerId, target, projectId])
  @@index([userId, status])
}

/// Secrets d'une connexion, chiffrés au repos.
///
/// Table séparée pour une raison simple : ce qui n'est jamais lu ne peut pas fuir. Le
/// service qui affiche les connexions ne la touche pas.
model IntegrationCredential {
  connectionId  String         @id @db.Uuid
  kind          CredentialKind
  /// Jeton d'accès ou clé, chiffré. Format : voir src/lib/crypto.ts.
  secret        String
  /// Jeton de rafraîchissement, chiffré, quand le fournisseur en délivre un.
  refreshSecret String?
  /// Quatre derniers caractères, pour que le créateur reconnaisse sa clé sans la révéler.
  hint          String?
  updatedAt     DateTime       @updatedAt

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

/// Journal technique d'une connexion. Jamais de secret, jamais de jeton.
model IntegrationEvent {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  connectionId String?  @db.Uuid
  providerId   String
  /// connected | disconnected | refreshed | refresh_failed | permission_denied | quota | error
  type         String
  detail       String?
  createdAt    DateTime @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model CreditWallet {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  balance      Int      @default(0)
  monthlyGrant Int      @default(0)
  resetsAt     DateTime
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Journal immuable des mouvements de crédits.
model CreditLedger {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  delta        Int
  balanceAfter Int
  reason       String
  projectId    String?  @db.Uuid
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Comptabilité fine des appels IA : jetons, coût réel, latence (exigence 37).
model AiUsage {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  projectId    String?  @db.Uuid
  operation    String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cachedTokens Int      @default(0)
  costMicros   Int      @default(0)
  creditsSpent Int      @default(0)
  latencyMs    Int      @default(0)
  success      Boolean  @default(true)
  errorCode    String?
  /// Message du fournisseur en cas d'échec, expurgé de tout secret, borné. Diagnostic seulement.
  errorMessage String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([success, createdAt])
}

// ─────────────────── Parcours entrepreneurial du créateur ────────────────────

/**
 * Profil du créateur : son objectif de revenu et ce dont il dispose.
 * C'est le fil conducteur du produit. L'objectif n'est jamais présenté comme un revenu
 * garanti : il sert uniquement à cadrer le choix d'idée, le modèle économique et le prix.
 */
model CreatorProfile {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @unique @db.Uuid
  /// Objectif de chiffre d'affaires mensuel visé, en centimes.
  monthlyGoalCents       Int
  weeklyHours            Int
  budgetCents            Int
  /// Monnaie de tous les montants du parcours. Aucune conversion n'est faite.
  currency               String    @default("EUR")
  country                String    @default("France")
  skills                 String    @default("")
  interests              String    @default("")
  sector                 String    @default("")
  /// particuliers | professionnels | les-deux
  audience               String    @default("particuliers")
  /// simple | ambitieux
  ambition               String    @default("simple")
  /// subscription | one_time | freemium | indifferent
  preferredModel         String    @default("indifferent")
  /// Ce que le Radar peut exploiter en plus. Tout est facultatif : rien n'est redemandé.
  experienceYears        Int?
  knownSectors           String    @default("")
  /// debutant | intermediaire | avance
  technicalLevel         String    @default("debutant")
  /// aucune | premiere | confirmee
  entrepreneurExperience String    @default("aucune")
  /// local | francophone | international
  marketScope            String    @default("francophone")
  /// saas | application | outil_metier | marketplace | indifferent
  productPreference      String    @default("indifferent")
  willingToProspect      Boolean?
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum IdeaStatus {
  PROPOSED
  SELECTED
  DISCARDED
  /// Mise de côté par le créateur : ni retenue, ni écartée.
  SAVED
  /// Sortie de la vue courante sans être écartée. Un « pas maintenant ».
  ARCHIVED
}

/**
 * Idée d'application proposée au créateur, chiffrée et comparable.
 * Les grandeurs commerciales sont enregistrées comme des nombres et non comme des
 * phrases : c'est ce qui permet de comparer des idées et de calculer le nombre de clients
 * nécessaires à l'objectif.
 */
model Idea {
  id                    String     @id @default(uuid()) @db.Uuid
  userId                String     @db.Uuid
  title                 String
  problem               String
  audience              String
  valueProposition      String
  /// Liste de fonctionnalités, en texte simple.
  features              Json
  /// free | one_time | subscription | freemium | credits
  businessModel         String
  recommendedPriceCents Int
  /// Monnaie dans laquelle l'idée a été chiffrée, figée à sa création.
  currency              String     @default("EUR")
  /// once | month | year
  priceInterval         String
  opportunityScore      Int
  /// faible | moyenne | bonne | forte
  demandLevel           String
  competitionLevel      String
  complexityLevel       String
  operatingCostLevel    String
  timeToMarketWeeks     Int
  /// Calculé par la plateforme, jamais par le modèle. Voir server/business/economics.ts
  customersNeeded       Int
  risks                 Json
  differentiators       Json
  /// Coût de fonctionnement mensuel estimé de l'application, en centimes.
  runningCostCents      Int        @default(0)
  /// Rapport de validation approfondie, produit à la demande.
  validation            Json?
  validatedAt           DateTime?
  /// Cahier des charges du MVP, lu et approuvé par le créateur avant construction.
  specSheet             Json?
  specSheetAt           DateTime?
  status                IdeaStatus @default(PROPOSED)
  /// D'où vient l'idée : parcours | radar | radar_projet.
  source                String     @default("parcours")
  /// Recherche du Radar qui l'a produite, quand c'est le cas.
  runId                 String?    @db.Uuid
  /// Pourquoi elle est proposée à cette personne : phrases lisibles, jamais un score nu.
  fitReasons            Json?
  /// Les cinq composantes du score, sur dix, pondérées par la plateforme.
  subScores             Json?
  /// Empreinte lexicale : ne pas reproposer la même idée sous un autre titre.
  fingerprint           String?
  rejectReason          String?
  savedAt               DateTime?
  archivedAt            DateTime?
  createdAt             DateTime   @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?
  feedback RadarFeedback[]
  signals  RadarSignal[]

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([userId, fingerprint])
  @@index([runId])
}

// ──────────────────────────────── Projets ────────────────────────────────────

enum ProjectStatus {
  DRAFT
  TESTING
  READY
  PUBLISHED
}

model Project {
  id                 String        @id @default(uuid()) @db.Uuid
  ownerId            String        @db.Uuid
  /// Idée dont ce projet est issu, quand il vient du parcours guidé.
  ideaId             String?       @unique @db.Uuid
  name               String
  slug               String        @unique
  status             ProjectStatus @default(DRAFT)
  locale             String        @default("fr")
  idea               String        @default("")
  blueprint          Json?
  draftSpec          Json
  specVersion        Int           @default(1)
  publishedVersionId String?       @db.Uuid
  publishedAt        DateTime?
  lastCheckScore     Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  owner                User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sourceIdea           Idea?                   @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  purchases            AppPurchase[]
  versions             ProjectVersion[]
  messages             ChatMessage[]
  checks               ProjectCheck[]
  records              AppRecord[]
  endUsers             AppEndUser[]
  events               AppEvent[]
  connections          IntegrationConnection[]
  marketing            MarketingKit[]
  medias               MediaAsset[]
  agentNotes           AgentNote[]
  radarRuns            RadarRun[]
  supportSettings      SupportSettings?
  supportKnowledge     SupportKnowledgeEntry[]
  supportConversations SupportConversation[]
  supportMessages      SupportMessage[]
  supportTickets       SupportTicket[]
  supportInsights      SupportInsight[]

  @@index([ownerId, updatedAt])
}

enum VersionSource {
  AI
  USER
  RESTORE
}

/// Version immuable de l'AppSpec.
model ProjectVersion {
  id        String        @id @default(uuid()) @db.Uuid
  projectId String        @db.Uuid
  number    Int
  label     String
  spec      Json
  source    VersionSource @default(AI)
  createdAt DateTime      @default(now())

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([projectId, number])
  @@index([projectId, createdAt])
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  userId    String?  @db.Uuid
  role      ChatRole
  content   String
  operation String?
  versionId String?  @db.Uuid
  createdAt DateTime @default(now())

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  version ProjectVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

/// Résultat d'une analyse de préparation à la publication (exigences 15 et 16).
model ProjectCheck {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  score     Int
  results   Json
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// ──────────────── Runtime des applications générées (isolé) ──────────────────

/// Utilisateur final d'une application créée. Cloisonné par projet.
model AppEndUser {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @db.Uuid
  email        String
  passwordHash String
  displayName  String?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime?

  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  records              AppRecord[]
  sessions             AppEndUserSession[]
  supportConversations SupportConversation[]
  supportTickets       SupportTicket[]
  purchases            AppPurchase[]

  @@unique([projectId, email])
}

/// Un achat fait par l'utilisateur d'une application créée, sur le compte Stripe du
/// créateur. L'argent ne transite jamais par Evoliia : on ne garde ici que la trace.
model AppPurchase {
  id                   String    @id @default(uuid()) @db.Uuid
  projectId            String    @db.Uuid
  endUserId            String?   @db.Uuid
  /// Offre de l'application (identifiant et nom dans l'AppSpec au moment de l'achat).
  planId               String
  planName             String
  /// payment | subscription
  mode                 String
  amountCents          Int       @default(0)
  currency             String
  /// paid | active | past_due | canceled | refunded
  status               String    @default("paid")
  stripeAccountId      String
  stripeSessionId      String    @unique
  stripeSubscriptionId String?
  /// Paiement à rembourser (paiement unique). Pour un abonnement, la dernière facture est relue chez Stripe.
  stripePaymentIntentId String?
  /// Commission d'Evoliia prélevée sur cette vente, restituée en cas de remboursement.
  applicationFeeCents  Int       @default(0)
  refundedCents        Int       @default(0)
  refundedAt           DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  endUser AppEndUser? @relation(fields: [endUserId], references: [id], onDelete: SetNull)

  @@index([projectId, status, createdAt])
  @@index([endUserId])
  @@index([stripePaymentIntentId])
  @@index([stripeSubscriptionId])
}

model AppEndUserSession {
  id        String    @id @default(uuid()) @db.Uuid
  endUserId String    @db.Uuid
  projectId String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  endUser AppEndUser @relation(fields: [endUserId], references: [id], onDelete: Cascade)

  @@index([endUserId])
}

/// Enregistrement de données d'une application créée.
/// La forme de `data` est validée côté serveur contre le modèle déclaré dans l'AppSpec.
model AppRecord {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  modelId        String
  ownerEndUserId String?  @db.Uuid
  data           Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   AppEndUser? @relation(fields: [ownerEndUserId], references: [id], onDelete: Cascade)

  @@index([projectId, modelId, createdAt])
  @@index([projectId, modelId, ownerEndUserId])
}

/// Événement d'usage pour les statistiques du créateur (exigence 33).
model AppEvent {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  type        String
  path        String?
  sessionHash String?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

/// Kit de lancement marketing produit par le moteur social, conservé pour le créateur.
///
/// Ce que le moteur renvoie n'est pas stocké chez lui : il est sans état. La seule copie
/// vit ici, dans la base d'Evoliia, sous la même règle de cloisonnement que le reste.
model MarketingKit {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  projectId      String    @db.Uuid
  /// Version du contrat du moteur, pour relire un ancien kit sans se tromper de forme.
  engineVersion  String
  /// Le kit lui-même : bénéfices, angles, idées, semaine. Modifiable par le créateur.
  content        Json
  /// Le mois, quand il a été préparé. Même kit, prolongé : mêmes angles, même marque.
  month          Json?
  model          String
  inputTokens    Int       @default(0)
  outputTokens   Int       @default(0)
  cachedTokens   Int       @default(0)
  /// Coût réel de l'appel, en micro-dollars. Alimente le calcul de marge par offre.
  costMicros     Int       @default(0)
  creditsSpent   Int       @default(0)
  /// Posé quand le créateur a relu et validé. Rien n'est publié sans ce geste.
  approvedAt     DateTime?
  /// Posé quand la semaine a été déposée en brouillon dans l'espace Postelya du créateur.
  /// Sert à le dire à l'écran, pas à empêcher un second envoi : celui-ci est sans effet.
  sentToSocialAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
}

/// Image téléversée par un créateur pour une de ses applications.
///
/// Stockée en base plutôt que chez un hébergeur de fichiers : cela évite un fournisseur de
/// plus, une facture de plus et un secret de plus, et l'image hérite du cloisonnement déjà
/// en place. Le volume reste borné par le quota de l'offre, ce qui est la condition pour
/// que mille créateurs ne se traduisent pas par une facture imprévisible.
model MediaAsset {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  projectId String   @db.Uuid
  /// Nom d'origine, pour que le créateur reconnaisse son fichier. Jamais utilisé comme chemin.
  filename  String
  /// Toujours image/webp : c'est ce que le traitement produit, quoi qu'on ait reçu.
  mime      String
  width     Int
  height    Int
  /// Poids de l'image stockée, après traitement. C'est lui qui compte dans le quota.
  bytes     Int
  /// L'image, ré-encodée et débarrassée de ses métadonnées.
  data      Bytes
  /// Vignette pour les écrans de l'atelier, pour ne pas charger l'originale dans une liste.
  thumb     Bytes
  /// upload | ai
  origin    String   @default("upload")
  /// Description donnée par le créateur quand l'image a été générée.
  prompt    String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId])
  @@index([userId, origin, createdAt])
}

/// Note d'un spécialiste marketing sur un projet.
///
/// Les trois métiers — social, référencement, lecture des résultats — regardent le même
/// projet. Ce qui les relie est ici : la phrase que chacun retient, et que les autres
/// reçoivent à leur tour. C'est ce qui distingue une équipe de trois assistants séparés.
model AgentNote {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  projectId    String   @db.Uuid
  /// Spécialiste : social, seo ou analytics.
  agent        String
  question     String
  answer       String
  /// Ce que ce spécialiste retient pour ses collègues, en une phrase.
  takeaway     String?
  creditsSpent Int      @default(0)
  createdAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([projectId, agent, createdAt])
}

// ═══════════════════════════════ Radar ════════════════════════════════════

/// Une recherche du Radar : le profil tel qu'il était, et ce qu'elle a coûté.
model RadarRun {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  /// manual | scheduled | project
  trigger         String   @default("manual")
  projectId       String?  @db.Uuid
  profileSnapshot Json
  ideaCount       Int      @default(0)
  model           String   @default("")
  costMicros      Int      @default(0)
  creditsSpent    Int      @default(0)
  createdAt       DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

/// Ce que le créateur pense d'une proposition. Sert à affiner, jamais à profiler.
model RadarFeedback {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  ideaId    String   @db.Uuid
  /// interested | not_for_me
  verdict   String
  /// too_complex | not_my_sector | too_competitive | too_expensive | no_b2b | other
  reason    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@unique([userId, ideaId])
  @@index([userId, createdAt])
}

/// Signal extérieur observé (V2). Source, date, confiance : jamais une interprétation.
model RadarSignal {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  ideaId     String?  @db.Uuid
  source     String
  /// search_trend | regulation | new_entrant | news | other
  type       String
  url        String?
  summary    String
  /// 0 à 100, déclarée par l'adaptateur.
  confidence Int      @default(50)
  observedAt DateTime
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea Idea? @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([userId, observedAt])
  @@index([ideaId])
}

// ════════════════════════════════ Lia ═════════════════════════════════════

/// Réglages de Lia pour une application. Une ligne par projet.
model SupportSettings {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  projectId       String   @unique @db.Uuid
  enabled         Boolean  @default(false)
  displayName     String   @default("Lia")
  greeting        String   @default("Bonjour 👋 Comment puis-je vous aider ?")
  /// bottom-right | bottom-left
  position        String   @default("bottom-right")
  accentColor     String?
  escalationEmail String?
  retentionDays   Int      @default(90)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Ce que Lia a le droit de dire. Une entrée générée naît en brouillon.
model SupportKnowledgeEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  projectId String   @db.Uuid
  /// manual | generated | spec
  kind      String   @default("manual")
  question  String
  answer    String
  keywords  String   @default("")
  /// draft | published | disabled
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([userId, createdAt])
}

/// Une conversation entre un visiteur et Lia.
model SupportConversation {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  projectId     String   @db.Uuid
  endUserId     String?  @db.Uuid
  /// Empreinte du visiteur anonyme : relie ses messages, ne retient rien de lui.
  visitorHash   String
  /// open | escalated | closed
  status        String   @default("open")
  category      String?
  messageCount  Int      @default(0)
  answeredCount Int      @default(0)
  /// +1 utile, -1 pas utile.
  satisfaction  Int?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  endUser  AppEndUser?      @relation(fields: [endUserId], references: [id], onDelete: SetNull)
  messages SupportMessage[]
  tickets  SupportTicket[]

  @@index([projectId, createdAt])
  @@index([projectId, status])
  @@index([projectId, visitorHash])
  @@index([userId, createdAt])
}

model SupportMessage {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  conversationId String   @db.Uuid
  /// visitor | lia | owner
  role           String
  content        String
  /// Vrai quand Lia s'est appuyée sur une entrée de la base.
  grounded       Boolean  @default(false)
  sources        Json?
  createdAt      DateTime @default(now())

  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([projectId, createdAt])
}

/// Une demande que Lia n'a pas su traiter, transmise au propriétaire.
model SupportTicket {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  projectId      String    @db.Uuid
  conversationId String?   @db.Uuid
  endUserId      String?   @db.Uuid
  email          String?
  subject        String
  category       String    @default("autre")
  /// low | normal | high
  priority       String    @default("normal")
  /// open | in_progress | resolved | closed
  status         String    @default("open")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  resolvedAt     DateTime?

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation SupportConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  endUser      AppEndUser?          @relation(fields: [endUserId], references: [id], onDelete: SetNull)

  @@index([projectId, status, createdAt])
  @@index([userId, createdAt])
}

/// Ce que les conversations révèlent, analysées par lot (V2).
model SupportInsight {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  projectId  String   @db.Uuid
  /// frequent_question | feature_request | potential_bug | unanswered
  kind       String
  title      String
  count      Int      @default(1)
  examples   Json     @default("[]")
  /// new | roadmap | dismissed
  status     String   @default("new")
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status, lastSeenAt])
  @@index([userId])
}

// ═══════════════════════════ Notifications ════════════════════════════════

/// Une notification interne. Une seule table : une seule cloche suffit.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  /// radar_new | support_ticket | support_insight | support_unanswered
  kind      String
  title     String
  body      String    @default("")
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}
