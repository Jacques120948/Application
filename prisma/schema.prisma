// Modèle de données AppForge.
// Trois domaines : plateforme, projets, runtime des applications générées.
// Voir docs/03-modele-de-donnees.md

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────────── Plateforme ──────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String
  name            String?
  locale          String    @default("fr")
  role            UserRole  @default(USER)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  disabledAt      DateTime?

  sessions      Session[]
  projects      Project[]
  tokens        VerificationToken[]
  subscription  Subscription?
  wallet        CreditWallet?
  creditEntries CreditLedger[]
  aiUsage       AiUsage[]
  chatMessages  ChatMessage[]

  @@index([createdAt])
}

/// Session du studio. Le jeton n'est jamais stocké en clair.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model VerificationToken {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  tokenHash  String       @unique
  purpose    TokenPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/// Offre commerciale de la plateforme. Modifiable depuis l'administration (exigence 34).
model Plan {
  id                String   @id
  name              String
  description       String
  priceCents        Int
  currency          String   @default("EUR")
  interval          String   @default("month")
  maxProjects       Int
  monthlyCredits    Int
  allowExport       Boolean  @default(false)
  allowCustomDomain Boolean  @default(false)
  allowMobilePrep   Boolean  @default(false)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @unique @db.Uuid
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([planId])
}

/// Solde de crédits IA. Cache : la vérité est la somme de CreditLedger.
model CreditWallet {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  balance      Int      @default(0)
  monthlyGrant Int      @default(0)
  resetsAt     DateTime
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Journal immuable des mouvements de crédits.
model CreditLedger {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  delta        Int
  balanceAfter Int
  reason       String
  projectId    String?  @db.Uuid
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Comptabilité fine des appels IA : jetons, coût réel, latence (exigence 37).
model AiUsage {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  projectId    String?  @db.Uuid
  operation    String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cachedTokens Int      @default(0)
  costMicros   Int      @default(0)
  creditsSpent Int      @default(0)
  latencyMs    Int      @default(0)
  success      Boolean  @default(true)
  errorCode    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ──────────────────────────────── Projets ────────────────────────────────────

enum ProjectStatus {
  DRAFT
  TESTING
  READY
  PUBLISHED
}

model Project {
  id                 String        @id @default(uuid()) @db.Uuid
  ownerId            String        @db.Uuid
  name               String
  slug               String        @unique
  status             ProjectStatus @default(DRAFT)
  locale             String        @default("fr")
  idea               String        @default("")
  blueprint          Json?
  draftSpec          Json
  specVersion        Int           @default(1)
  publishedVersionId String?       @db.Uuid
  publishedAt        DateTime?
  lastCheckScore     Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  owner    User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions ProjectVersion[]
  messages ChatMessage[]
  checks   ProjectCheck[]
  records  AppRecord[]
  endUsers AppEndUser[]
  events   AppEvent[]

  @@index([ownerId, updatedAt])
}

enum VersionSource {
  AI
  USER
  RESTORE
}

/// Version immuable de l'AppSpec.
model ProjectVersion {
  id        String        @id @default(uuid()) @db.Uuid
  projectId String        @db.Uuid
  number    Int
  label     String
  spec      Json
  source    VersionSource @default(AI)
  createdAt DateTime      @default(now())

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([projectId, number])
  @@index([projectId, createdAt])
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  userId    String?  @db.Uuid
  role      ChatRole
  content   String
  operation String?
  versionId String?  @db.Uuid
  createdAt DateTime @default(now())

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  version ProjectVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

/// Résultat d'une analyse de préparation à la publication (exigences 15 et 16).
model ProjectCheck {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  score     Int
  results   Json
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// ──────────────── Runtime des applications générées (isolé) ──────────────────

/// Utilisateur final d'une application créée. Cloisonné par projet.
model AppEndUser {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @db.Uuid
  email        String
  passwordHash String
  displayName  String?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime?

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  records  AppRecord[]
  sessions AppEndUserSession[]

  @@unique([projectId, email])
}

model AppEndUserSession {
  id        String    @id @default(uuid()) @db.Uuid
  endUserId String    @db.Uuid
  projectId String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  endUser AppEndUser @relation(fields: [endUserId], references: [id], onDelete: Cascade)

  @@index([endUserId])
}

/// Enregistrement de données d'une application créée.
/// La forme de `data` est validée côté serveur contre le modèle déclaré dans l'AppSpec.
model AppRecord {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @db.Uuid
  modelId         String
  ownerEndUserId  String?  @db.Uuid
  data            Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   AppEndUser? @relation(fields: [ownerEndUserId], references: [id], onDelete: Cascade)

  @@index([projectId, modelId, createdAt])
  @@index([projectId, modelId, ownerEndUserId])
}

/// Événement d'usage pour les statistiques du créateur (exigence 33).
model AppEvent {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  type        String
  path        String?
  sessionHash String?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}
