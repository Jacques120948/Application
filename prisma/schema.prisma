// Modèle de données AppForge.
// Trois domaines : plateforme, projets, runtime des applications générées.
// Voir docs/03-modele-de-donnees.md

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────────── Plateforme ──────────────────────────────────

/// Où sert la connexion. La distinction est structurante : une connexion « EVOLIIA » sert
/// au créateur pendant qu'il construit, une connexion « APP » servira à son application une
/// fois en ligne. Les deux ne vivent pas la même vie et ne se révoquent pas ensemble.
enum IntegrationTarget {
  EVOLIIA
  APP
}

enum IntegrationStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

/// Comment le fournisseur nous autorise. OAuth quand il le propose ; clé fournie par le
/// créateur seulement quand aucun OAuth n'existe et que le fournisseur l'autorise.
enum CredentialKind {
  OAUTH
  API_KEY
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  passwordHash     String
  name             String?
  locale           String    @default("fr")
  role             UserRole  @default(USER)
  emailVerifiedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  disabledAt       DateTime?
  /// Alertes du Radar : nouvelles opportunités correspondant au profil.
  radarAlerts      Boolean   @default(true)
  /// Alertes de Lia : question qui revient, ticket ouvert, question sans réponse.
  supportAlerts    Boolean   @default(true)
  /// Client Stripe correspondant, créé au premier paiement.
  stripeCustomerId String?   @unique

  sessions             Session[]
  projects             Project[]
  connections          IntegrationConnection[]
  integrationEvents    IntegrationEvent[]
  marketingKits        MarketingKit[]
  medias               MediaAsset[]
  agentNotes           AgentNote[]
  radarRuns            RadarRun[]
  radarFeedback        RadarFeedback[]
  radarSignals         RadarSignal[]
  supportSettings      SupportSettings[]
  supportKnowledge     SupportKnowledgeEntry[]
  supportConversations SupportConversation[]
  supportTickets       SupportTicket[]
  supportInsights      SupportInsight[]
  notifications        Notification[]
  ownerAlerts          OwnerAlert[]
  profile              CreatorProfile?
  ideas                Idea[]
  tokens               VerificationToken[]
  subscription         Subscription?
  wallet               CreditWallet?
  creditEntries        CreditLedger[]
  creditReservations   CreditReservation[]
  aiUsage              AiUsage[]
  chatMessages         ChatMessage[]
  reports              CreatorReport[]
  unmetRequests        UnmetRequest[]
  sites                Site[]
  audits               Audit[]
  actionItems          ActionItem[]
  auditCorrections     AuditCorrection[]
  visibilityNotes      VisibilityNote[]
  siteArticles         SiteArticle[]
  siteImages           SiteImage[]
  siteWatches          SiteWatch[]
  siteAutomatisations  SiteAutomatisation[]
  promptsIa            PromptIA[]
  relevesIa            ReleveIA[]
  pointsHebdo          PointHebdo[]
  adsComptes           AdsAccount[]
  adsProfils           AdsProfil[]
  adsCampagnes         AdsCampagne[]
  adsReleves           AdsReleve[]
  adsRecommandations   AdsRecommandation[]
  adsActions           AdsAction[]
  adsGroupes           AdsGroupe[]
  adsAnnonces          AdsAnnonce[]
  adsElements          AdsElement[]
  adsTermes            AdsTerme[]
  adsPropositions      AdsProposition[]
  adsMotsCles          AdsMotCle[]
  adsPlans             AdsPlanCampagne[]
  releveRecherches     ReleveRecherche[]
  volumesRecherche     VolumeRecherche[]

  @@index([createdAt])
}

/// Session du studio. Le jeton n'est jamais stocké en clair.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  /// Dernier signe de vie. Sert la déconnexion pour inactivité : une session oubliée sur
  /// un poste partagé ne doit pas rester ouverte jusqu'à son échéance lointaine.
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model VerificationToken {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  tokenHash  String       @unique
  purpose    TokenPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/// Offre commerciale de la plateforme. Modifiable depuis l'administration (exigence 34).
/// Réglages de l'installation, modifiables depuis le back-office sans redéploiement.
/// Table clé/valeur volontairement simple : les réglages sont rares et hétérogènes.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Plan {
  id                       String   @id
  name                     String
  description              String
  priceCents               Int
  currency                 String   @default("EUR")
  interval                 String   @default("month")
  maxProjects              Int
  /// Connexions externes autorisées. Modifiable depuis le back-office, comme le reste.
  maxConnections           Int      @default(0)
  /// Fonctions ouvertes par cette offre, par identifiant (voir server/billing/features.ts).
  /// Source de vérité des droits : le code ne décide jamais d'après le nom de l'offre.
  features                 String[] @default([])
  /// Espace d'images autorisé, en octets. Borne la seule dépense qui grandirait sinon
  /// avec l'usage plutôt qu'avec le nombre de clients.
  storageBytes             Int      @default(0)
  /// Quotas mensuels des deux modules. Réglables depuis le back-office, comme le reste.
  radarRunsPerMonth        Int      @default(1)
  liaAnswersPerMonth       Int      @default(0)
  liaConversationsPerMonth Int      @default(0)
  /// Alertes par courriel envoyées au créateur quand un visiteur saisit une fiche.
  /// Zéro par défaut : la fonction s'ouvre offre par offre, depuis le back-office.
  alertsPerMonth           Int      @default(0)
  /// Images créées par l'IA sur le compte d'Evoliia, et non sur celui du créateur.
  /// Zéro par défaut : c'est une dépense réelle pour la plateforme, elle s'ouvre offre
  /// par offre. Le créateur qui connecte sa propre clé n'est pas concerné par ce quota.
  imagesPerMonth           Int      @default(0)
  /// Sites qu'une offre permet de suivre, et pages analysées à chaque audit.
  /// Zéro par défaut : une offre d'une version précédente ne doit pas se retrouver à
  /// promettre un produit qui n'existait pas quand elle a été souscrite.
  sitesMax                 Int      @default(0)
  pagesPerAudit            Int      @default(0)
  /// Audits accordés par mois et par site. Borne la seule dépense qui grandirait avec
  /// l'usage : chaque audit est un parcours réel de pages sur le réseau.
  auditsPerMonth           Int      @default(0)
  monthlyCredits           Int
  allowExport              Boolean  @default(false)
  allowCustomDomain        Boolean  @default(false)
  allowMobilePrep          Boolean  @default(false)
  /// Permet de générer réellement une application. L'offre gratuite s'arrête avant.
  allowBuild               Boolean  @default(true)
  /// Mise en avant dans la grille tarifaire.
  isRecommended            Boolean  @default(false)
  isActive                 Boolean  @default(true)
  sortOrder                Int      @default(0)
  /// Prix pour douze mois payés d'avance, en centimes. Zéro : cette offre ne se prend pas
  /// à l'année. La remise n'est écrite nulle part — elle se déduit des deux prix réglés.
  priceYearCents           Int      @default(0)
  /// Produit et tarif Stripe, créés à la demande. L'empreinte dit pour quel prix, quelle
  /// monnaie et quelle période le tarif a été créé.
  stripeProductId          String?
  stripePriceId            String?
  stripePriceFingerprint   String?
  /// Le tarif annuel, gardé à part : chez Stripe ce sont deux tarifs distincts, et une
  /// colonne unique ferait payer au mois quelqu'un qui a choisi l'année.
  stripePriceIdYear          String?
  stripePriceFingerprintYear String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @unique @db.Uuid
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  /// Résiliation demandée : l'offre reste active jusqu'à la fin de la période payée.
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([stripeSubscriptionId])
}

/// Un événement Stripe reçu. Retenu pour n'être traité qu'une fois. Table globale.
model StripeEvent {
  id         String   @id
  type       String
  account    String?
  receivedAt DateTime @default(now())
}

/// Solde de crédits IA. Cache : la vérité est la somme de CreditLedger.
/// Connexion d'un créateur à un service externe.
///
/// Aucun secret ici : cette table est lue pour afficher la liste des connexions, et cette
/// lecture ne doit jamais approcher un jeton. Les secrets vivent dans IntegrationCredential.
model IntegrationConnection {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  /// Identifiant du fournisseur dans le catalogue applicatif, par exemple "google-drive".
  providerId     String
  target         IntegrationTarget @default(EVOLIIA)
  /// Projet concerné, quand la connexion sert une application précise.
  projectId      String?           @db.Uuid
  status         IntegrationStatus @default(CONNECTED)
  /// Autorisations réellement accordées par le fournisseur, telles qu'il les a renvoyées.
  scopes         String[]          @default([])
  /// Compte distant, affiché au créateur pour qu'il sache ce qu'il a connecté.
  accountLabel   String?
  connectedAt    DateTime          @default(now())
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  /// Dernière erreur, en clair et sans secret : « autorisation refusée », « quota dépassé ».
  lastError      String?
  disconnectedAt DateTime?
  updatedAt      DateTime          @updatedAt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  credential IntegrationCredential?
  events     IntegrationEvent[]

  @@unique([userId, providerId, target, projectId])
  @@index([userId, status])
}

/// Secrets d'une connexion, chiffrés au repos.
///
/// Table séparée pour une raison simple : ce qui n'est jamais lu ne peut pas fuir. Le
/// service qui affiche les connexions ne la touche pas.
model IntegrationCredential {
  connectionId  String         @id @db.Uuid
  kind          CredentialKind
  /// Jeton d'accès ou clé, chiffré. Format : voir src/lib/crypto.ts.
  secret        String
  /// Jeton de rafraîchissement, chiffré, quand le fournisseur en délivre un.
  refreshSecret String?
  /// Quatre derniers caractères, pour que le créateur reconnaisse sa clé sans la révéler.
  hint          String?
  updatedAt     DateTime       @updatedAt

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

/// Journal technique d'une connexion. Jamais de secret, jamais de jeton.
model IntegrationEvent {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  connectionId String?  @db.Uuid
  providerId   String
  /// connected | disconnected | refreshed | refresh_failed | permission_denied | quota | error
  type         String
  detail       String?
  createdAt    DateTime @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model CreditWallet {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  balance      Int      @default(0)
  monthlyGrant Int      @default(0)
  resetsAt     DateTime
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Pourquoi un solde a changé. Le motif libre restait lisible mais pas dénombrable :
/// impossible de répondre à « combien de crédits vendus ce mois » sans analyser du texte.
enum CreditMovement {
  /// Dotation mensuelle d'une offre, ou rattrapage après un changement d'offre.
  SUBSCRIPTION_CREDIT
  /// Pack acheté séparément de l'abonnement.
  CREDIT_PURCHASE
  /// Débit d'un appel au modèle.
  AI_USAGE
  /// Remboursement d'un achat.
  REFUND
  /// Correction manuelle depuis l'administration.
  ADJUSTMENT
  /// Geste commercial.
  BONUS
  /// Crédits périmés à l'échéance mensuelle.
  EXPIRED_CREDIT
}

/// Journal immuable des mouvements de crédits. C'est lui qui fait foi, pas le solde.
model CreditLedger {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  delta           Int
  balanceAfter    Int
  /// Motif lisible, conservé tel quel : il dit ce que le type ne dit pas.
  reason          String
  type            CreditMovement @default(ADJUSTMENT)
  projectId       String?        @db.Uuid
  /// L'appel au modèle qui a provoqué ce débit, quand il y en a un.
  aiUsageId       String?        @db.Uuid
  /// Le paiement Stripe qui a provoqué ce crédit. Unique : un paiement ne crédite qu'une fois.
  stripePaymentId String?        @unique
  createdAt       DateTime       @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiUsage AiUsage? @relation(fields: [aiUsageId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

/// Crédits mis de côté le temps d'une opération.
///
/// Sans elle, deux opérations lancées en même temps voient le même solde et le dépassent
/// toutes les deux. Une réservation retire les crédits du solde disponible avant l'appel,
/// et ne les débite vraiment qu'une fois la consommation connue ; le reste est rendu.
model CreditReservation {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  projectId  String?   @db.Uuid
  operation  String
  /// Plafond mis de côté, en crédits.
  amount     Int
  /// Passé cette date, la réservation ne compte plus : un processus interrompu ne gèle
  /// pas des crédits pour toujours.
  expiresAt  DateTime
  releasedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, releasedAt])
  @@index([expiresAt])
}

/// Tarif d'un modèle, en centimes de dollar par million de jetons.
///
/// C'est l'unité dans laquelle Anthropic publie ses prix : la recopier telle quelle évite
/// une conversion à la main le jour d'un changement de tarif. Le code garde les valeurs
/// actuelles en secours, donc une table vide ne casse rien.
model AiModelPricing {
  model                 String   @id
  label                 String
  inputCentsPerMTok     Int
  outputCentsPerMTok    Int
  cacheReadCentsPerMTok Int
  isActive              Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

/// Comptabilité fine des appels IA : jetons, coût réel, latence (exigence 37).
/// Un créateur signale ce qu'il n'a pas pu résoudre lui-même.
///
/// Sans Row Level Security, comme AiUsage et pour la même raison : ces lignes n'existent
/// que pour être lues par l'exploitant, et aucun écran de créateur ne les relit. Une table
/// qu'on ne lit jamais par erreur n'a pas besoin qu'on l'empêche de mal la lire ; l'écriture,
/// elle, tient son identifiant de la session et jamais du navigateur.
model CreatorReport {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  projectId String?   @db.Uuid
  /// L'écran d'où il écrit, tel que l'interface le nomme.
  screen    String
  message   String
  /// Les faits rassemblés par le serveur : offre, crédits, incidents récents.
  context   String
  /// open | handled
  status    String    @default("open")
  handledAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

/// Une demande à laquelle l'assistant n'a rien pu faire.
///
/// C'est la feuille de route écrite par les créateurs plutôt que devinée : ce qu'ils
/// demandent et qu'Evoliia ne sait pas encore construire. Jetée jusqu'ici à mesure.
model UnmetRequest {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  projectId String   @db.Uuid
  request   String
  reply     String
  /// Vrai quand l'assistant a dit explicitement que la demande sortait de son vocabulaire.
  /// Faux quand il n'a simplement rien changé : une question, un refus implicite, un échec.
  explicit  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([explicit, createdAt])
}

model AiUsage {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  projectId    String?  @db.Uuid
  operation    String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cachedTokens Int      @default(0)
  costMicros   Int      @default(0)
  creditsSpent Int      @default(0)
  latencyMs    Int      @default(0)
  success      Boolean  @default(true)
  errorCode    String?
  /// Message du fournisseur en cas d'échec, expurgé de tout secret, borné. Diagnostic seulement.
  errorMessage String?
  createdAt    DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditEntries CreditLedger[]

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([success, createdAt])
}

// ─────────────────── Parcours entrepreneurial du créateur ────────────────────

/**
 * Profil du créateur : son objectif de revenu et ce dont il dispose.
 * C'est le fil conducteur du produit. L'objectif n'est jamais présenté comme un revenu
 * garanti : il sert uniquement à cadrer le choix d'idée, le modèle économique et le prix.
 */
model CreatorProfile {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @unique @db.Uuid
  /// Objectif de chiffre d'affaires mensuel visé, en centimes.
  monthlyGoalCents       Int
  weeklyHours            Int
  budgetCents            Int
  /// Monnaie de tous les montants du parcours. Aucune conversion n'est faite.
  currency               String    @default("EUR")
  country                String    @default("France")
  skills                 String    @default("")
  interests              String    @default("")
  sector                 String    @default("")
  /// particuliers | professionnels | les-deux
  audience               String    @default("particuliers")
  /// simple | ambitieux
  ambition               String    @default("simple")
  /// subscription | one_time | freemium | indifferent
  preferredModel         String    @default("indifferent")
  /// Ce que le Radar peut exploiter en plus. Tout est facultatif : rien n'est redemandé.
  experienceYears        Int?
  knownSectors           String    @default("")
  /// debutant | intermediaire | avance
  technicalLevel         String    @default("debutant")
  /// aucune | premiere | confirmee
  entrepreneurExperience String    @default("aucune")
  /// local | francophone | international
  marketScope            String    @default("francophone")
  /// saas | application | outil_metier | marketplace | indifferent
  productPreference      String    @default("indifferent")
  willingToProspect      Boolean?
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum IdeaStatus {
  PROPOSED
  SELECTED
  DISCARDED
  /// Mise de côté par le créateur : ni retenue, ni écartée.
  SAVED
  /// Sortie de la vue courante sans être écartée. Un « pas maintenant ».
  ARCHIVED
}

/**
 * Idée d'application proposée au créateur, chiffrée et comparable.
 * Les grandeurs commerciales sont enregistrées comme des nombres et non comme des
 * phrases : c'est ce qui permet de comparer des idées et de calculer le nombre de clients
 * nécessaires à l'objectif.
 */
model Idea {
  id                    String     @id @default(uuid()) @db.Uuid
  userId                String     @db.Uuid
  title                 String
  problem               String
  audience              String
  valueProposition      String
  /// Liste de fonctionnalités, en texte simple.
  features              Json
  /// free | one_time | subscription | freemium | credits
  businessModel         String
  recommendedPriceCents Int
  /// Monnaie dans laquelle l'idée a été chiffrée, figée à sa création.
  currency              String     @default("EUR")
  /// once | month | year
  priceInterval         String
  opportunityScore      Int
  /// faible | moyenne | bonne | forte
  demandLevel           String
  competitionLevel      String
  complexityLevel       String
  operatingCostLevel    String
  timeToMarketWeeks     Int
  /// Calculé par la plateforme, jamais par le modèle. Voir server/business/economics.ts
  customersNeeded       Int
  risks                 Json
  differentiators       Json
  /// Coût de fonctionnement mensuel estimé de l'application, en centimes.
  runningCostCents      Int        @default(0)
  /// Rapport de validation approfondie, produit à la demande.
  validation            Json?
  validatedAt           DateTime?
  /// Cahier des charges du MVP, lu et approuvé par le créateur avant construction.
  specSheet             Json?
  specSheetAt           DateTime?
  status                IdeaStatus @default(PROPOSED)
  /// D'où vient l'idée : parcours | radar | radar_projet.
  source                String     @default("parcours")
  /// Recherche du Radar qui l'a produite, quand c'est le cas.
  runId                 String?    @db.Uuid
  /// Pourquoi elle est proposée à cette personne : phrases lisibles, jamais un score nu.
  fitReasons            Json?
  /// Les cinq composantes du score, sur dix, pondérées par la plateforme.
  subScores             Json?
  /// Empreinte lexicale : ne pas reproposer la même idée sous un autre titre.
  fingerprint           String?
  rejectReason          String?
  savedAt               DateTime?
  archivedAt            DateTime?
  createdAt             DateTime   @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?
  feedback RadarFeedback[]
  signals  RadarSignal[]

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([userId, fingerprint])
  @@index([runId])
}

// ──────────────────────────────── Projets ────────────────────────────────────

enum ProjectStatus {
  DRAFT
  TESTING
  READY
  PUBLISHED
}

model Project {
  id                 String        @id @default(uuid()) @db.Uuid
  ownerId            String        @db.Uuid
  /// Idée dont ce projet est issu, quand il vient du parcours guidé.
  ideaId             String?       @unique @db.Uuid
  name               String
  slug               String        @unique
  status             ProjectStatus @default(DRAFT)
  locale             String        @default("fr")
  idea               String        @default("")
  blueprint          Json?
  draftSpec          Json
  specVersion        Int           @default(1)
  publishedVersionId String?       @db.Uuid
  publishedAt        DateTime?
  lastCheckScore     Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  owner                User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sourceIdea           Idea?                   @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  purchases            AppPurchase[]
  versions             ProjectVersion[]
  messages             ChatMessage[]
  checks               ProjectCheck[]
  records              AppRecord[]
  endUsers             AppEndUser[]
  endUserTokens        AppEndUserToken[]
  events               AppEvent[]
  connections          IntegrationConnection[]
  marketing            MarketingKit[]
  medias               MediaAsset[]
  ownerAlerts          OwnerAlert[]
  agentNotes           AgentNote[]
  radarRuns            RadarRun[]
  supportSettings      SupportSettings?
  supportKnowledge     SupportKnowledgeEntry[]
  supportConversations SupportConversation[]
  supportMessages      SupportMessage[]
  supportTickets       SupportTicket[]
  supportInsights      SupportInsight[]

  @@index([ownerId, updatedAt])
}

enum VersionSource {
  AI
  USER
  RESTORE
}

/// Version immuable de l'AppSpec.
model ProjectVersion {
  id        String        @id @default(uuid()) @db.Uuid
  projectId String        @db.Uuid
  number    Int
  label     String
  spec      Json
  source    VersionSource @default(AI)
  createdAt DateTime      @default(now())

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([projectId, number])
  @@index([projectId, createdAt])
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

/// État d'une modification annoncée avant d'être appliquée.
enum PlanStatus {
  /// Préparée et validée, en attente de la décision du créateur.
  PROPOSED
  APPLIED
  CANCELLED
  /// Le brouillon a changé entre la proposition et la décision : le plan ne vaut plus.
  STALE
}

model ChatMessage {
  id         String      @id @default(uuid()) @db.Uuid
  projectId  String      @db.Uuid
  userId     String?     @db.Uuid
  role       ChatRole
  content    String
  operation  String?
  versionId  String?     @db.Uuid
  /// Modification préparée mais pas encore appliquée : opérations, résumé, motifs.
  /// Présente uniquement sur les messages de l'agent qui attendent une confirmation.
  plan       Json?
  planStatus PlanStatus?
  /// Empreinte du brouillon sur lequel le plan a été calculé. Un brouillon qui a changé
  /// depuis rend le plan caduc : on préfère le refaire plutôt que l'appliquer à l'aveugle.
  planBase   String?
  createdAt  DateTime    @default(now())

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  version ProjectVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

/// Résultat d'une analyse de préparation à la publication (exigences 15 et 16).
model ProjectCheck {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  score     Int
  results   Json
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// ──────────────── Runtime des applications générées (isolé) ──────────────────

/// Utilisateur final d'une application créée. Cloisonné par projet.
model AppEndUser {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @db.Uuid
  email        String
  passwordHash String
  displayName  String?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime?

  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  records              AppRecord[]
  sessions             AppEndUserSession[]
  tokens               AppEndUserToken[]
  supportConversations SupportConversation[]
  supportTickets       SupportTicket[]
  purchases            AppPurchase[]

  @@unique([projectId, email])
}

/// Un achat fait par l'utilisateur d'une application créée, sur le compte Stripe du
/// créateur. L'argent ne transite jamais par Evoliia : on ne garde ici que la trace.
model AppPurchase {
  id                    String    @id @default(uuid()) @db.Uuid
  projectId             String    @db.Uuid
  endUserId             String?   @db.Uuid
  /// Offre de l'application (identifiant et nom dans l'AppSpec au moment de l'achat).
  planId                String
  planName              String
  /// payment | subscription
  mode                  String
  amountCents           Int       @default(0)
  currency              String
  /// paid | active | past_due | canceled | refunded
  status                String    @default("paid")
  stripeAccountId       String
  stripeSessionId       String    @unique
  stripeSubscriptionId  String?
  /// Paiement à rembourser (paiement unique). Pour un abonnement, la dernière facture est relue chez Stripe.
  stripePaymentIntentId String?
  /// Commission d'Evoliia prélevée sur cette vente, restituée en cas de remboursement.
  applicationFeeCents   Int       @default(0)
  refundedCents         Int       @default(0)
  refundedAt            DateTime?
  currentPeriodEnd      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  endUser AppEndUser? @relation(fields: [endUserId], references: [id], onDelete: SetNull)

  @@index([projectId, status, createdAt])
  @@index([endUserId])
  @@index([stripePaymentIntentId])
  @@index([stripeSubscriptionId])
}

model AppEndUserSession {
  id        String    @id @default(uuid()) @db.Uuid
  endUserId String    @db.Uuid
  projectId String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  endUser AppEndUser @relation(fields: [endUserId], references: [id], onDelete: Cascade)

  @@index([endUserId])
}

/// Jeton à usage unique d'un visiteur d'application : réinitialisation de mot de passe.
/// Jamais stocké en clair — seule une empreinte HMAC, comme les jetons de session.
model AppEndUserToken {
  id         String    @id @default(uuid()) @db.Uuid
  projectId  String    @db.Uuid
  endUserId  String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  endUser AppEndUser @relation(fields: [endUserId], references: [id], onDelete: Cascade)
  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([endUserId])
  @@index([projectId, expiresAt])
}

/// Enregistrement de données d'une application créée.
/// La forme de `data` est validée côté serveur contre le modèle déclaré dans l'AppSpec.
model AppRecord {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  modelId        String
  ownerEndUserId String?  @db.Uuid
  data           Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   AppEndUser?  @relation(fields: [ownerEndUserId], references: [id], onDelete: Cascade)
  photos  MediaAsset[]

  @@index([projectId, modelId, createdAt])
  @@index([projectId, modelId, ownerEndUserId])
}

/// Événement d'usage pour les statistiques du créateur (exigence 33).
model AppEvent {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  type        String
  path        String?
  sessionHash String?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

/// Kit de lancement marketing produit par le moteur social, conservé pour le créateur.
///
/// Ce que le moteur renvoie n'est pas stocké chez lui : il est sans état. La seule copie
/// vit ici, dans la base d'Evoliia, sous la même règle de cloisonnement que le reste.
model MarketingKit {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  projectId      String    @db.Uuid
  /// Version du contrat du moteur, pour relire un ancien kit sans se tromper de forme.
  engineVersion  String
  /// Le kit lui-même : bénéfices, angles, idées, semaine. Modifiable par le créateur.
  content        Json
  /// Le mois, quand il a été préparé. Même kit, prolongé : mêmes angles, même marque.
  month          Json?
  model          String
  inputTokens    Int       @default(0)
  outputTokens   Int       @default(0)
  cachedTokens   Int       @default(0)
  /// Coût réel de l'appel, en micro-dollars. Alimente le calcul de marge par offre.
  costMicros     Int       @default(0)
  creditsSpent   Int       @default(0)
  /// Posé quand le créateur a relu et validé. Rien n'est publié sans ce geste.
  approvedAt     DateTime?
  /// Posé quand la semaine a été déposée en brouillon dans l'espace Postelya du créateur.
  /// Sert à le dire à l'écran, pas à empêcher un second envoi : celui-ci est sans effet.
  sentToSocialAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
}

/// Image téléversée par un créateur pour une de ses applications.
///
/// Stockée en base plutôt que chez un hébergeur de fichiers : cela évite un fournisseur de
/// plus, une facture de plus et un secret de plus, et l'image hérite du cloisonnement déjà
/// en place. Le volume reste borné par le quota de l'offre, ce qui est la condition pour
/// que mille créateurs ne se traduisent pas par une facture imprévisible.
model MediaAsset {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  projectId String   @db.Uuid
  /// Nom d'origine, pour que le créateur reconnaisse son fichier. Jamais utilisé comme chemin.
  filename  String
  /// Toujours image/webp : c'est ce que le traitement produit, quoi qu'on ait reçu.
  mime      String
  width     Int
  height    Int
  /// Poids de l'image stockée, après traitement. C'est lui qui compte dans le quota.
  bytes     Int
  /// L'image, ré-encodée et débarrassée de ses métadonnées.
  data      Bytes
  /// Vignette pour les écrans de l'atelier, pour ne pas charger l'originale dans une liste.
  thumb     Bytes
  /// upload | ai | visitor
  origin    String   @default("upload")
  /// Description donnée par le créateur quand l'image a été générée.
  prompt    String?
  /// Fiche à laquelle cette photo est attachée, pour une image envoyée par un visiteur.
  /// La suppression en cascade est voulue : une fiche effacée ne doit pas laisser ses
  /// photos occuper indéfiniment le quota de stockage du créateur.
  recordId  String?  @db.Uuid
  createdAt DateTime @default(now())

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  record  AppRecord? @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId])
  @@index([userId, origin, createdAt])
  @@index([projectId, origin, recordId])
}

/// Note d'un spécialiste marketing sur un projet.
///
/// Les trois métiers — social, référencement, lecture des résultats — regardent le même
/// projet. Ce qui les relie est ici : la phrase que chacun retient, et que les autres
/// reçoivent à leur tour. C'est ce qui distingue une équipe de trois assistants séparés.
model AgentNote {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  projectId    String   @db.Uuid
  /// Spécialiste : social, seo ou analytics.
  agent        String
  question     String
  answer       String
  /// Ce que ce spécialiste retient pour ses collègues, en une phrase.
  takeaway     String?
  creditsSpent Int      @default(0)
  createdAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([projectId, agent, createdAt])
}

// ═══════════════════════════════ Radar ════════════════════════════════════

/// Une recherche du Radar : le profil tel qu'il était, et ce qu'elle a coûté.
model RadarRun {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  /// manual | scheduled | project
  trigger         String   @default("manual")
  projectId       String?  @db.Uuid
  profileSnapshot Json
  ideaCount       Int      @default(0)
  model           String   @default("")
  costMicros      Int      @default(0)
  creditsSpent    Int      @default(0)
  createdAt       DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

/// Ce que le créateur pense d'une proposition. Sert à affiner, jamais à profiler.
model RadarFeedback {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  ideaId    String   @db.Uuid
  /// interested | not_for_me
  verdict   String
  /// too_complex | not_my_sector | too_competitive | too_expensive | no_b2b | other
  reason    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@unique([userId, ideaId])
  @@index([userId, createdAt])
}

/// Signal extérieur observé (V2). Source, date, confiance : jamais une interprétation.
model RadarSignal {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  ideaId     String?  @db.Uuid
  source     String
  /// search_trend | regulation | new_entrant | news | other
  type       String
  url        String?
  summary    String
  /// 0 à 100, déclarée par l'adaptateur.
  confidence Int      @default(50)
  observedAt DateTime
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea Idea? @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([userId, observedAt])
  @@index([ideaId])
}

// ════════════════════════════════ Lia ═════════════════════════════════════

/// Réglages de Lia pour une application. Une ligne par projet.
model SupportSettings {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  projectId       String   @unique @db.Uuid
  enabled         Boolean  @default(false)
  displayName     String   @default("Lia")
  greeting        String   @default("Bonjour 👋 Comment puis-je vous aider ?")
  /// bottom-right | bottom-left
  position        String   @default("bottom-right")
  accentColor     String?
  escalationEmail String?
  retentionDays   Int      @default(90)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Ce que Lia a le droit de dire. Une entrée générée naît en brouillon.
model SupportKnowledgeEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  projectId String   @db.Uuid
  /// manual | generated | spec
  kind      String   @default("manual")
  question  String
  answer    String
  keywords  String   @default("")
  /// draft | published | disabled
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([userId, createdAt])
}

/// Une conversation entre un visiteur et Lia.
model SupportConversation {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  projectId     String   @db.Uuid
  endUserId     String?  @db.Uuid
  /// Empreinte du visiteur anonyme : relie ses messages, ne retient rien de lui.
  visitorHash   String
  /// open | escalated | closed
  status        String   @default("open")
  category      String?
  messageCount  Int      @default(0)
  answeredCount Int      @default(0)
  /// +1 utile, -1 pas utile.
  satisfaction  Int?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  endUser  AppEndUser?      @relation(fields: [endUserId], references: [id], onDelete: SetNull)
  messages SupportMessage[]
  tickets  SupportTicket[]

  @@index([projectId, createdAt])
  @@index([projectId, status])
  @@index([projectId, visitorHash])
  @@index([userId, createdAt])
}

model SupportMessage {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  conversationId String   @db.Uuid
  /// visitor | lia | owner
  role           String
  content        String
  /// Vrai quand Lia s'est appuyée sur une entrée de la base.
  grounded       Boolean  @default(false)
  sources        Json?
  createdAt      DateTime @default(now())

  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([projectId, createdAt])
}

/// Une demande que Lia n'a pas su traiter, transmise au propriétaire.
model SupportTicket {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  projectId      String    @db.Uuid
  conversationId String?   @db.Uuid
  endUserId      String?   @db.Uuid
  email          String?
  subject        String
  category       String    @default("autre")
  /// low | normal | high
  priority       String    @default("normal")
  /// open | in_progress | resolved | closed
  status         String    @default("open")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  resolvedAt     DateTime?

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation SupportConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  endUser      AppEndUser?          @relation(fields: [endUserId], references: [id], onDelete: SetNull)

  @@index([projectId, status, createdAt])
  @@index([userId, createdAt])
}

/// Ce que les conversations révèlent, analysées par lot (V2).
model SupportInsight {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  projectId  String   @db.Uuid
  /// frequent_question | feature_request | potential_bug | unanswered
  kind       String
  title      String
  count      Int      @default(1)
  examples   Json     @default("[]")
  /// new | roadmap | dismissed
  status     String   @default("new")
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status, lastSeenAt])
  @@index([userId])
}

// ═══════════════════════════ Notifications ════════════════════════════════

/// Une notification interne. Une seule table : une seule cloche suffit.
/// Une alerte envoyée au créateur parce qu'un visiteur a saisi une fiche.
///
/// Sa raison d'être est le comptage : le quota mensuel de l'offre et le plafond journalier
/// par application se lisent ici. Elle sert aussi de trace — « pourquoi n'ai-je pas été
/// prévenu ? » a une réponse vérifiable, ce qu'un simple compteur ne donnerait pas.
model OwnerAlert {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  projectId String   @db.Uuid
  modelId   String
  recordId  String   @db.Uuid
  /// Faux quand l'alerte a été retenue : quota atteint, plafond du jour, ou envoi en échec.
  sent      Boolean  @default(true)
  /// Motif de la retenue, pour le diagnostic. Jamais montré au visiteur.
  reason    String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  /// radar_new | support_ticket | support_insight | support_unanswered
  kind      String
  title     String
  body      String    @default("")
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// ─────────────────────────── Visibilité : sites et audits ───────────────────

/// Un site suivi par un utilisateur. C'est l'objet central du nouveau produit :
/// tout — audits, constats, plan d'action — pend à lui.
model Site {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  /// Origine canonique : protocole + hôte, sans chemin ni barre finale.
  origin String
  /// Le nom d'hôte seul, pour l'unicité et l'affichage.
  host   String
  /// Comment l'utilisateur appelle ce site. Le nom d'hôte par défaut.
  label  String
  /// Ce que l'entreprise fait, en une phrase, dit par l'utilisateur. Sert de contexte
  /// à l'IA pour les corrections : sans lui, elle rédige des généralités.
  about  String @default("")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  /// Dernier passage de la surveillance. Vide tant qu'elle n'a jamais tourné sur ce site.
  watchedAt DateTime?

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  audits         Audit[]
  items          ActionItem[]
  corrections    AuditCorrection[]
  notes          VisibilityNote[]
  articles       SiteArticle[]
  images         SiteImage[]
  watches        SiteWatch[]
  automatisation SiteAutomatisation?
  promptsIa      PromptIA[]
  relevesIa      ReleveIA[]
  points         PointHebdo[]
  releves        ReleveRecherche[]
  volumes        VolumeRecherche[]

  /// Deux fois le même site pour la même personne n'aurait aucun sens, et ferait
  /// diverger deux historiques qui devraient n'en faire qu'un.
  @@unique([userId, host])
  @@index([userId, updatedAt])
}

/// Une passe d'analyse. Conservée telle quelle : c'est elle qui permet de dire
/// « +6 depuis le dernier audit » sans recalculer le passé.
model Audit {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @db.Uuid
  userId String @db.Uuid

  /// pending | running | done | failed
  status  String @default("pending")
  /// manual | scheduled
  trigger String @default("manual")

  /// Bornes réellement appliquées, figées dans l'audit : un réglage changé
  /// plus tard ne doit pas réécrire ce qui a été mesuré.
  maxPages Int @default(50)
  maxDepth Int @default(3)

  pagesCrawled Int @default(0)
  /// Pages écartées : hors domaine, refusées par robots, non HTML, en erreur.
  pagesSkipped Int @default(0)

  /// Sur 100, calculés par Evoliia selon des pondérations administrables.
  /// Nuls tant que l'audit n'est pas terminé.
  seoScore Int?
  geoScore Int?
  /// La note de conversion. Nulle sur un audit antérieur à Cleo : « pas encore mesuré »
  /// n'est pas « mesuré à zéro », et l'écran doit pouvoir les distinguer.
  croScore Int?

  /// Ce qui s'observe une fois pour le site entier — robots.txt, plan de site, protocole —
  /// et non page par page. Relevé à la première tranche, quand l'accueil est visité, et
  /// figé là : les contrôles de fin d'audit en ont besoin longtemps après.
  siteSignals Json?
  /// Code d'échec, jamais le message brut du serveur distant.
  errorCode   String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  site     Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages    AuditPage[]
  findings AuditFinding[]

  @@index([siteId, startedAt])
  @@index([userId, startedAt])
  /// Le tableau de bord, le plan d'action, l'historique et chaque question posée à l'équipe
  /// commencent par « la dernière analyse terminée de ce site ». Sans cet index, c'est un
  /// balayage complet à chaque écran — invisible à dix audits, ruineux à quarante mille.
  @@index([siteId, status, finishedAt])
}

/// Une page visitée, et les signaux qu'on en a extraits.
///
/// Les signaux sont rangés en JSON plutôt qu'en colonnes : leur liste grandira à
/// chaque contrôle ajouté, et une migration par contrôle serait absurde. Ce qui est
/// en colonne est ce sur quoi on trie ou on filtre.
model AuditPage {
  id      String @id @default(uuid()) @db.Uuid
  auditId String @db.Uuid

  url        String
  /// Chemin seul, pour l'affichage et le tri.
  path       String
  depth      Int    @default(0)
  statusCode Int    @default(0)
  bytes      Int    @default(0)
  /// Durée de la requête, en millisecondes.
  fetchMs    Int    @default(0)
  /// Redirections traversées pour arriver ici. Chacune coûte un aller-retour au visiteur,
  /// et une chaîne de plusieurs sauts est un constat en soi.
  redirects  Int    @default(0)

  /// Titre et description relevés, pour les afficher sans relire le JSON.
  title       String @default("")
  description String @default("")
  wordCount   Int    @default(0)

  /// Tout le reste de ce qui a été extrait de la page.
  signals Json

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, url])
  @@index([auditId, depth])
}

/// Le résultat d'un contrôle sur l'ensemble de l'audit.
///
/// Agrégé par contrôle, et non par page et par contrôle. Cinquante pages et
/// quarante-cinq contrôles feraient deux mille deux cent cinquante lignes à relire
/// à chaque affichage pour dire la même chose — et « quatorze fiches produits sans
/// description » est exactement la phrase qu'il faut montrer.
model AuditFinding {
  id      String @id @default(uuid()) @db.Uuid
  auditId String @db.Uuid

  /// Identifiant stable du contrôle : c'est lui qui relie un constat d'un audit
  /// à l'autre, et à l'état choisi dans le plan d'action.
  checkId  String
  /// seo | geo
  engine   String
  /// critical | important | improvement | passed
  severity String

  /// Pages concernées, et pages examinées par ce contrôle. Le rapport des deux dit
  /// l'ampleur ; le nombre brut dit l'effort.
  affected Int @default(0)
  examined Int @default(0)

  /// Poids du contrôle dans le score, figé au moment de l'audit.
  weight Int @default(0)
  /// Points perdus sur ce contrôle. Ce qui fait le score, et ce qui fait la priorité.
  lost   Int @default(0)

  /// Quelques exemples : adresses concernées et valeur relevée. Jamais toutes les
  /// pages — une liste de cinquante adresses n'aide personne à commencer.
  sample Json

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, checkId])
  @@index([auditId, engine, lost])
}

/// L'état d'un constat dans le plan d'action, attaché au site et non à l'audit.
///
/// C'est délibéré : « corrigée » ou « ignorée » doit survivre à l'audit suivant,
/// sans quoi la liste repartirait de zéro chaque mois et ne serait plus un plan.
model ActionItem {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @db.Uuid
  userId String @db.Uuid

  checkId String
  /// todo | doing | done | ignored
  state   String @default("todo")
  /// Ce que la personne a noté pour elle-même.
  note    String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, checkId])
  @@index([userId, state])
}

/// Une correction rédigée par l'IA pour un constat, attachée au site.
///
/// Elle est enregistrée et non rendue une fois : elle a coûté des crédits, et un
/// texte payé qui disparaît au rechargement de la page est un texte volé. C'est
/// aussi ce qui permet d'y revenir plus tard, quand on a le temps de coller.
///
/// Evoliia ne touche jamais au site du client : ce texte est à copier, et le
/// bouton qui l'appliquerait n'existe pas.
/// Un article rédigé par l'équipe, à partir de ce que l'analyse reproche au site.
///
/// Le corps est du Markdown : c'est ce qu'un modèle écrit le plus proprement, ce qui se
/// relit sans balise, et ce qui se convertit ensuite vers n'importe quel site. Les questions
/// sont à part parce qu'elles se déclarent en FAQ — ce que les contrôles GEO attendent.
/// Un défaut repéré par la surveillance, ouvert tant qu'il dure.
///
/// Un constat s'ouvre quand le défaut apparaît et se ferme quand il a disparu, plutôt que
/// de créer une ligne par passage : un site en panne six semaines produirait sinon six
/// lignes identiques, et l'écran dirait « six problèmes » là où il y en a un depuis six
/// semaines.
model SiteWatch {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @db.Uuid
  userId String @db.Uuid

  /// Identifiant stable du contrôle : watch.unreachable, watch.noindex…
  checkId String
  /// L'adresse concernée, quand le constat porte sur une page précise.
  url     String @default("")
  /// Ce qui a été constaté, dit comme la personne le lira.
  detail  String @default("")

  openedAt DateTime  @default(now())
  /// Rempli au premier contrôle où le défaut a disparu.
  closedAt DateTime?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([siteId, closedAt])
}

/// Ce que la personne a accepté de laisser tourner seul, pour un site.
///
/// Tout est à « non » au départ : rien ne se déclenche parce qu'une fonctionnalité existe.
/// La rédaction automatique dépense des crédits, donc elle porte son rythme avec elle — ce
/// qui est autorisé est aussi ce qui est borné.
model SiteAutomatisation {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @unique @db.Uuid
  userId String @db.Uuid

  /// Demander chaque nuit à Google l'état de quelques pages. Gratuit.
  indexation Boolean @default(false)
  /// Garder une trace quotidienne des chiffres de recherche. Gratuit.
  releve     Boolean @default(false)
  /// Faire écrire les articles du calendrier sans les demander. Dépense des crédits.
  redaction  Boolean @default(false)
  /// Déposer l'article écrit en brouillon dans Shopify. Jamais publié.
  depot      Boolean @default(false)
  /// Poser régulièrement les questions suivies aux assistants. Dépense des crédits.
  assistants Boolean @default(false)
  /// Tous les combien, en jours : 7, 14 ou 30. C'est la borne de la dépense la plus lourde
  /// du produit, et elle se règle parce que ce qu'un assistant répond bouge au mois.
  assistantsJours Int @default(7)
  /// Les assistants réellement interrogés pour ce site. Vide : tous ceux qui sont
  /// disponibles. Le prix suit cette liste — on ne facture que ce qu'on interroge.
  plateformesIA String[] @default([])
  /// Le point hebdomadaire de Léa sur l'ensemble du site. Dépense des crédits.
  point      Boolean @default(false)

  /// Le blog Shopify qui reçoit les dépôts. Vide : le premier de la boutique.
  blogId     String @default("")
  /// Le rythme autorisé, repris du calendrier. C'est la borne de la dépense.
  parPeriode Int    @default(1)
  /// semaine | mois
  periode    String @default("semaine")

  indexeAt     DateTime?
  releveAt     DateTime?
  redigeAt     DateTime?
  assistantsAt DateTime?

  /// Début du passage en cours, ou vide quand aucun ne tourne.
  passageAt      DateTime?
  /// Combien de questions ce passage couvre. L'avancement se compte sur les relevés écrits.
  passageAttendu Int       @default(0)
  pointAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Une photographie quotidienne des chiffres de recherche.
///
/// Les écrans ne conservent rien : ils lisent chez Google et jettent. Mais « cette requête
/// a gagné quatre places cette semaine » ne se dit pas sans une trace d'hier.
model ReleveRecherche {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @db.Uuid
  userId String @db.Uuid

  /// Le jour relevé. Les chiffres portent sur les 28 jours qui le précèdent.
  jour        DateTime @db.Date
  clics       Int      @default(0)
  impressions Int      @default(0)
  /// Les requêtes les plus vues ce jour-là, telles que Google les rend.
  requetes    Json     @default("[]")

  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, jour])
  @@index([siteId, jour(sort: Desc)])
}

/// Le volume de recherche d'un mot, gardé plutôt que redemandé.
///
/// Search Console dit combien de fois le site a été montré sur une recherche ; il ne dit
/// jamais combien de fois cette recherche a été tapée. L'écart est tout le sujet : sortir
/// trentième sur un mot cherché cinq mille fois donne moins d'affichages que sortir troisième
/// sur un mot cherché vingt fois, et les chiffres de Search Console montrent donc ces deux
/// lignes dans le mauvais ordre.
///
/// Gardé, et non relu à chaque affichage : un volume est une moyenne mensuelle. Le redemander
/// à chaque ouverture d'écran consommerait le quota d'appels d'Evoliia — partagé par tous ses
/// utilisateurs — pour une valeur qui n'aura pas bougé.
model VolumeRecherche {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  siteId String @db.Uuid

  /// Le mot normalisé : minuscules, espaces réduits. Deux formes donneraient deux lignes
  /// pour un seul mot, et un cache qui ne trouve jamais rien.
  motCle String
  /// La ressource géographique de Google, ex. « geoTargetConstants/2756 ».
  marche String
  /// Le code de langue à deux lettres, tel qu'Evoliia le manipule.
  langue String

  /// La moyenne mensuelle rendue par Google. -1 : demandé, mais Google n'a rien à dire —
  /// distinct de 0, qui est une réponse : personne ne cherche cela.
  volume         Int    @default(-1)
  /// LOW | MEDIUM | HIGH | '', tel que Google le nomme.
  concurrence    String @default("")
  /// Ce que ce mot vaut à ceux qui le paient. Un repère, même sans intention d'acheter.
  coutBasMicros  BigInt @default(0)
  coutHautMicros BigInt @default(0)

  releveAt  DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, marche, langue, motCle], map: "VolumeRecherche_cle_key")
  @@index([siteId, releveAt])
}

/// Une question qu'un client pourrait poser à un assistant, et où la marque devrait sortir.
///
/// Écrite par la personne : elle connaît son marché, et une question inventée par un modèle
/// mesurerait l'imagination du modèle.
model PromptIA {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @db.Uuid
  userId String @db.Uuid

  /// La question, telle qu'un client la poserait. Dans sa langue.
  texte String
  /// Le regroupement choisi par la personne.
  theme String  @default("")
  /// Éteinte : elle garde son historique et cesse d'être posée et facturée.
  actif Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site    Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  releves ReleveIA[]

  @@unique([siteId, texte])
  @@index([siteId, actif])
}

/// Une réponse d'assistant, lue et constatée.
///
/// Ces réponses ne sont pas déterministes : la même question posée deux fois donne deux
/// réponses. C'est l'accumulation qui fait le chiffre — « vue dans 3 relevés sur 10 » est
/// une fréquence, « vue » serait un mensonge.
model ReleveIA {
  id       String @id @default(uuid()) @db.Uuid
  promptId String @db.Uuid
  siteId   String @db.Uuid
  userId   String @db.Uuid

  /// gemini | claude | perplexity. La plateforme réellement interrogée, jamais une
  /// plateforme approchante dont on emprunterait le nom.
  plateforme String
  /// La marque apparaît-elle. Constaté sur le texte, pas déduit.
  mentionne  Boolean @default(false)
  /// bon | neutre | reserve | inconnu. Seulement quand la marque est mentionnée.
  sentiment  String  @default("inconnu")
  /// Le passage où la marque apparaît, pour que la personne vérifie elle-même.
  extrait    String  @default("")
  /// Les adresses citées par l'assistant : c'est là que se voit qui il a lu.
  sources    Json    @default("[]")

  createdAt DateTime @default(now())

  prompt PromptIA @relation(fields: [promptId], references: [id], onDelete: Cascade)
  site   Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([promptId, createdAt(sort: Desc)])
  @@index([siteId, createdAt(sort: Desc)])
}

/// Le point hebdomadaire de Léa : où en est ce site, et par quoi continuer.
///
/// Conservé plutôt que recalculé : il coûte un appel, et il date — « voilà où vous en étiez
/// lundi » se compare au lundi suivant.
model PointHebdo {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @db.Uuid
  userId String @db.Uuid

  /// Où en est ce site, en quelques phrases, sur des faits mesurés.
  etat      String @default("")
  /// Les prochaines actions : quoi, pourquoi, et par quel spécialiste.
  actions   Json   @default("[]")
  /// Ce qui a servi à l'écrire, pour relire un point ancien sans deviner.
  fondement Json   @default("{}")

  creditsSpent Int      @default(0)
  createdAt    DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt(sort: Desc)])
}

/// Une image créée pour illustrer un article, faute de fiche qui corresponde.
///
/// Elle ne contient rien qui décrive le travail en cours — ni la demande envoyée au modèle,
/// ni le sujet — parce que sa lecture est publique : elle est faite pour être servie au
/// visiteur d'un blog. Voir la migration pour le détail du cloisonnement.
/// Ce que MIRA a fait chez Meta, vu de l'exploitant — et rien de plus.
///
/// Aucune donnée de client : ni personne, ni compte, ni campagne, ni montant. Le geste, son
/// issue, la réponse de Meta sur un refus. Elle existe parce que le journal, lui, est
/// cloisonné par propriétaire et reste donc illisible depuis le back-office — ce qui est
/// voulu. Voir la migration pour le raisonnement complet.
model MetaSupervision {
  id        String   @id @default(uuid()) @db.Uuid
  quoi      String
  resultat  String
  detail    String   @default("")
  /// Vrai quand le geste défaisait une modification précédente.
  retour    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

model SiteImage {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @db.Uuid
  userId String @db.Uuid

  /// Toujours image/webp : c'est ce que le ré-encodage produit, quoi que le fournisseur rende.
  mime   String
  width  Int
  height Int
  bytes  Int
  data   Bytes
  /// Le texte de remplacement, qui part tel quel dans le blog.
  alt    String @default("")
  /// Crédits réellement débités, au coût constaté.
  creditsSpent Int @default(0)

  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([siteId])
}

model SiteArticle {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @db.Uuid
  userId String @db.Uuid

  /// Le sujet retenu, tel qu'il sera relu.
  sujet         String
  /// Ce que la personne a demandé, quand elle a demandé quelque chose. Vide sinon.
  demande       String    @default("")
  /// Pourquoi ce sujet : ce que l'analyse reprochait au site, dit par l'équipe.
  fondement     String    @default("")
  /// Les contrôles que cet article vise à combler. Sert à les afficher, pas à promettre.
  checkIds      String[]  @default([])
  /// Les recherches réelles données au rédacteur, quand Search Console était relié.
  /// Conservées pour qu'on sache, en relisant l'article un an plus tard, sur quelle demande
  /// il a été écrit — et vide quand il n'a été fondé que sur les manques du site.
  recherches    String[]  @default([])
  /// [{ section, titre, image, alt, lien }] : les photos de la boutique retenues.
  /// Les adresses pointent la boutique, jamais une copie : Evoliia ne stocke aucune image.
  illustrations Json?
  /// Identifiant Shopify de l'article, une fois déposé. Vide tant qu'il ne l'a pas été.
  /// Sa présence est ce qui empêche un second dépôt, et donc un doublon dans la boutique.
  shopifyId     String?
  /// L'écran Shopify où le relire et le publier.
  shopifyUrl    String?
  shopifyAt     DateTime?

  titre String
  /// Le premier paragraphe, celui qui doit répondre avant qu'on fasse défiler.
  chapo String @default("")
  corps String

  /// [{ question, reponse }]. Séparées du corps : elles se déclarent, elles ne se racontent pas.
  questions Json?

  metaTitle       String @default("")
  metaDescription String @default("")

  wordCount    Int @default(0)
  /// Crédits réellement débités pour cet article.
  creditsSpent Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
}

model AuditCorrection {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @db.Uuid
  userId String @db.Uuid

  /// Le contrôle qui a motivé la correction.
  checkId String
  /// Page visée, telle que l'audit l'a relevée.
  path    String
  url     String @default("")
  /// title | description | h1 | intro
  field   String
  /// Ce qui était en place. Une correction se relit par comparaison.
  before  String @default("")
  after   String

  /// Crédits réellement débités pour le lot dont cette ligne fait partie.
  creditsSpent Int @default(0)

  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, checkId, path, field])
  @@index([siteId, checkId])
}

/// Un échange avec un spécialiste de la visibilité, attaché au site.
///
/// Séparé d'`AgentNote`, qui pend à un projet du constructeur : ce ne sont ni
/// les mêmes interlocuteurs, ni le même objet, ni le même périmètre de lecture.
/// Les fondre aurait demandé un identifiant de projet facultatif, c'est-à-dire
/// une colonne vide dans la moitié des lignes et une jointure qui ment.
model VisibilityNote {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @db.Uuid
  userId String @db.Uuid

  /// audit | seo | geo | content
  agent    String
  question String
  answer   String
  /// Ce que ce spécialiste retient pour ses collègues, en une phrase.
  takeaway String?

  creditsSpent Int      @default(0)
  createdAt    DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@index([siteId, agent, createdAt])
}

/// Tentatives de connexion ratées, comptées là où elles survivent au redémarrage.
///
/// Le compteur en mémoire du processus ne suffit pas : sur un hébergement sans état, chaque
/// requête peut tomber sur une instance neuve, dont le compteur est vide. Une limite qui ne
/// tient que dans une mémoire volatile n'est pas une limite.
///
/// Rien n'est stocké en clair. Ni l'adresse visée, ni l'adresse IP : seulement leur
/// empreinte. Une copie de cette table ne dit pas qui a essayé de se connecter, ni d'où.
model AuthThrottle {
  id           String    @id @default(uuid()) @db.Uuid
  /// « email » ou « ip » : ce que compte cette ligne.
  scope        String
  /// Empreinte HMAC de la valeur comptée. Jamais la valeur elle-même.
  keyHash      String
  failures     Int       @default(0)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([scope, keyHash])
  @@index([blockedUntil])
}

// ─────────────────────────── Naya — la publicité ─────────────────────────────
//
// Six tables, et la raison d'être de l'ensemble tient en une phrase : sans mesure d'hier,
// on ne peut rien dire d'aujourd'hui. Google Ads rend l'état du moment ; il ne rend pas
// « votre ROAS a baissé de dix-huit points cette semaine ». Cette phrase-là se fabrique en
// gardant une ligne par campagne et par jour, et en soustrayant.
//
// L'argent est en micros, en entier long. Google rend des millionièmes d'unité monétaire ;
// les convertir en nombre à virgule à l'écriture ferait entrer une imprécision dans la
// seule donnée du produit qui soit de l'argent réel. La conversion se fait à la lecture.

/// Un compte publicitaire relié. Les jetons vivent ailleurs, chiffrés : voir
/// `IntegrationCredential`. Cette table ne porte que ce qu'on affiche.
model AdsAccount {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  /// « google-ads » aujourd'hui ; Meta et Microsoft s'y rangeront.
  plateforme         String    @default("google-ads")
  /// L'identifiant du compte chez la plateforme. Chez Google : le customer ID sans tirets.
  compteId           String
  nom                String    @default("")
  /// CHF, EUR, USD… telle que la plateforme la déclare. Jamais déduite.
  devise             String    @default("")
  /// Le fuseau du compte : c'est lui qui décide où commence une journée de dépense.
  fuseau             String    @default("")
  /// Un compte administrateur ne diffuse pas de publicité : il en gère d'autres.
  gestionnaire       Boolean   @default(false)
  /// Celui que Naya lit. On peut en relier plusieurs et n'en suivre qu'un.
  actif              Boolean   @default(false)
  /// lecture | assiste. Ce que Naya a le droit de faire ici. « lecture » par défaut : une
  /// autorisation Google donne le droit d'écrire, elle ne dit pas qu'on le souhaite.
  mode               String    @default("lecture")
  /// Dernière synchronisation réussie, affichée telle quelle.
  synchroAt          DateTime?
  /// Combien d'actions de conversion sont activées ET comptées dans « Conversions ».
  /// -1 : jamais lu, ce qui n'est pas 0. Un compte peut porter cent actions activées mais
  /// secondaires — des restes d'un outil tiers — et n'avoir aucune vente comptée.
  conversionsActives Int       @default(-1)
  /// Dernière lecture du créatif : annonces, éléments, termes de recherche. Séparée parce
  /// qu'elle n'a pas le même rythme — les dépenses changent chaque nuit, les titres non.
  creaAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  profil          AdsProfil?
  campagnes       AdsCampagne[]
  releves         AdsReleve[]
  recommandations AdsRecommandation[]
  actions         AdsAction[]
  groupes         AdsGroupe[]
  annonces        AdsAnnonce[]
  elements        AdsElement[]
  termes          AdsTerme[]
  propositions    AdsProposition[]
  motsCles        AdsMotCle[]
  plans           AdsPlanCampagne[]

  @@unique([userId, plateforme, compteId])
  @@index([userId, actif])
}

/// Ce que la personne vise. Un ROAS de 250 % est excellent pour l'une et insuffisant pour
/// l'autre : c'est sa marge qui tranche, pas une moyenne de marché.
model AdsProfil {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  accountId String @unique @db.Uuid

  activite            String @default("")
  pays                String @default("")
  produits            String @default("")
  panierMoyenMicros   BigInt @default(0)
  /// Marge moyenne en pourcentage entier. C'est elle qui rend un ROAS interprétable.
  margePourcent       Int    @default(0)
  /// Objectif de rentabilité en pourcentage entier : 200 veut dire 200 %.
  roasCible           Int    @default(0)
  cpaCibleMicros      BigInt @default(0)
  budgetMensuelMicros BigInt @default(0)
  /// conversions | valeur | roas | cpa
  objectif            String @default("conversions")

  /// Les bornes du pilote automatique, posées avant le mode lui-même et toutes fermées.
  ///
  /// Un pilote sans plafond est exactement ce que le produit s'interdit depuis le premier
  /// jour : « Naya n'a jamais d'autonomie financière illimitée ». Elles sont distinctes des
  /// objectifs ci-dessus, et la nuance décide de tout — le CPA cible dit ce qu'on vise, le
  /// CPA maximum dit à partir de quand une machine doit cesser de dépenser. Les confondre
  /// laisserait un agent s'autoriser tout ce qui n'a pas encore atteint la cible.
  ///
  /// Faux tant que la personne ne l'a pas explicitement armé : le mode du compte ne suffit
  /// pas, deux interrupteurs valent mieux qu'un pour ce qui engage de l'argent seul.
  piloteActif               Boolean @default(false)
  /// En pourcentage entier. 0 : aucune hausse autorisée, ce qui est le défaut.
  piloteHausseMaxPourcent   Int     @default(0)
  piloteBaisseMaxPourcent   Int     @default(0)
  /// Le budget quotidien qu'aucune hausse automatique ne peut franchir.
  piloteBudgetJourMaxMicros BigInt  @default(0)
  /// La dépense mensuelle au-delà de laquelle le pilote se tait.
  piloteDepenseMaxMicros    BigInt  @default(0)
  /// La limite, pas la cible. Au-delà, une machine ne monte plus un budget.
  piloteCpaMaxMicros        BigInt  @default(0)
  /// En pourcentage entier : 250 veut dire 250 %. En deçà, le pilote ne monte rien.
  piloteRoasMin             Int     @default(0)
  /// Les campagnes où le pilote a le droit d'agir. Une liste blanche, jamais une liste
  /// noire : l'oubli doit fermer, pas ouvrir.
  piloteCampagnes           Json    @default("[]")
  /// Les types d'action autorisés : budget, pause, reprise. Vide : aucun.
  piloteActions             Json    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  account AdsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

/// Une campagne et son état du moment.
model AdsCampagne {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  accountId String @db.Uuid

  /// L'identifiant chez la plateforme : c'est lui qu'on renvoie pour modifier quoi que ce soit.
  campagneId   String
  nom          String  @default("")
  /// SEARCH | SHOPPING | PERFORMANCE_MAX… tel que la plateforme le nomme.
  type         String  @default("")
  /// ENABLED | PAUSED | REMOVED, tel quel.
  statut       String  @default("")
  budgetMicros BigInt  @default(0)
  /// Chez Google, un budget peut servir plusieurs campagnes : le modifier sans le savoir
  /// changerait le budget d'une campagne qu'on ne regardait pas.
  budgetId     String  @default("")
  /// Vrai quand la plateforme signale que la campagne est bridée par son budget.
  budgetLimite Boolean @default(false)
  /// La langue ciblée, lue dans le ciblage de la campagne — jamais devinée sur les mots.
  /// Vide quand la campagne en cible plusieurs ou aucune : on ne sait pas, on le dit.
  langue       String  @default("")

  vueAt     DateTime @default(now())
  createdAt DateTime @default(now())

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         AdsAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  releves         AdsReleve[]
  recommandations AdsRecommandation[]
  actions         AdsAction[]
  adsGroupes      AdsGroupe[]
  adsTermes       AdsTerme[]

  @@unique([accountId, campagneId])
}

/// Un contenant d'annonces : groupe d'annonces (Recherche) ou groupe d'éléments (PMax).
/// Deux mots de Google pour un même rôle ; les garder distincts remplirait le code de
/// conditions, et Meta en apporterait un troisième.
model AdsGroupe {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  accountId  String @db.Uuid
  campagneId String @db.Uuid

  groupeId String @default("")
  nom      String @default("")
  /// annonces | elements
  genre    String @default("annonces")
  statut   String @default("")

  /// Le budget quotidien, quand il vit à ce niveau. Chez Google il est sur la campagne et
  /// partagé ; chez Meta il est sur l'ensemble, sauf quand la campagne le pilote. 0 veut
  /// dire « pas ici », donc « ne touchez pas à ce niveau ».
  budgetMicros BigInt  @default(0)
  budgetId     String  @default("")
  budgetLimite Boolean @default(false)

  vueAt     DateTime @default(now())
  createdAt DateTime @default(now())

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      AdsAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campagne     AdsCampagne      @relation(fields: [campagneId], references: [id], onDelete: Cascade)
  elements     AdsElement[]
  propositions AdsProposition[]
  motsCles     AdsMotCle[]
  annonces     AdsAnnonce[]

  @@unique([accountId, groupeId])
  @@index([campagneId])
}

/// Une annonce, telle que Meta l'entend : une chose, pas une collection de morceaux.
///
/// Chez Google, une annonce responsive est un assemblage de titres et de descriptions, et
/// AdsElement les porte déjà. Chez Meta, l'annonce a un visuel, un identifiant et des
/// chiffres à elle. Sans cette table, l'onglet Créatives n'aurait rien à montrer et MIRA ne
/// saurait pas dire « cette publicité-ci consomme sans vendre ».
model AdsAnnonce {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  accountId String @db.Uuid
  groupeId  String @db.Uuid

  /// L'identifiant chez la plateforme : c'est lui qu'on renvoie pour mettre en pause.
  annonceId String @default("")
  nom       String @default("")
  /// ACTIVE | PAUSED | ARCHIVED… le vocabulaire de la plateforme, repris tel quel.
  statut    String @default("")
  /// IMAGE | VIDEO | CAROUSEL… vide quand la plateforme ne le dit pas.
  format    String @default("")
  /// L'adresse de l'aperçu chez la plateforme. Jamais l'image elle-même : la recopier
  /// ferait d'Evoliia un hébergeur de créatives, avec la conservation que cela suppose.
  apercu    String @default("")

  vueAt     DateTime @default(now())
  createdAt DateTime @default(now())

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  account AdsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupe  AdsGroupe  @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  @@unique([accountId, annonceId])
  @@index([groupeId])
}

/// Un morceau d'annonce : un titre, une description, une image.
model AdsElement {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  accountId String @db.Uuid
  groupeId  String @db.Uuid

  /// titre | titre-long | description | image | logo
  champ       String
  /// Le texte, ou l'adresse de l'image.
  texte       String
  elementId   String @default("")
  /// LOW | GOOD | BEST | LEARNING | PENDING, la note de Google reprise telle quelle.
  performance String @default("")
  /// google | evoliia : d'où vient ce morceau.
  origine     String @default("google")

  vueAt     DateTime @default(now())
  createdAt DateTime @default(now())

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  account AdsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupe  AdsGroupe  @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  @@unique([groupeId, champ, texte])
  @@index([accountId, champ])
}

/// Ce que Naya propose d'ajouter à une annonce. Séparé des éléments réels : ranger une
/// proposition parmi les titres existants ferait compter « 12 sur 15 » à une annonce qui
/// n'en a que neuf, et la personne croirait son travail fait.
model AdsProposition {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  accountId String @db.Uuid
  groupeId  String @db.Uuid

  /// titre | titre-long | description
  champ String
  texte String
  /// Sur quoi elle s'appuie : ce qui la rend discutable plutôt qu'à prendre ou à laisser.
  motif String @default("")
  /// proposee | deposee | ecartee
  etat  String @default("proposee")

  createdAt DateTime  @default(now())
  closedAt  DateTime?

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  account AdsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupe  AdsGroupe  @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  @@unique([groupeId, champ, texte])
  @@index([groupeId, etat])
}

/// Ce que les gens ont réellement tapé pour déclencher une annonce. Une photographie, pas
/// un historique : réécrite à chaque lecture.
model AdsTerme {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  accountId  String @db.Uuid
  campagneId String @db.Uuid

  terme       String
  impressions BigInt @default(0)
  clics       BigInt @default(0)
  conversions Float  @default(0)
  coutMicros  BigInt @default(0)
  /// achat | comparaison | local | information
  intention   String @default("information")

  vueAt     DateTime @default(now())
  createdAt DateTime @default(now())

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  AdsAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campagne AdsCampagne @relation(fields: [campagneId], references: [id], onDelete: Cascade)

  @@unique([campagneId, terme])
  @@index([accountId])
}

/// Une ligne par campagne et par jour. C'est la table qui porte tout le reste : une
/// variation est une soustraction, et elle exige qu'on ait gardé les deux journées.
model AdsReleve {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  accountId  String @db.Uuid
  campagneId String @db.Uuid

  /// L'ensemble de publicités, quand la ligne le concerne. Chaîne vide : ligne de campagne.
  /// Meta se lit en trois niveaux là où Google s'arrêtait à la campagne. Chaîne vide plutôt
  /// que NULL : Postgres tient deux NULL pour distincts dans un index unique, et le doublon
  /// se serait vu des semaines plus tard, dans une dépense comptée deux fois.
  groupeId  String @default("")
  /// L'annonce, même règle. Chaîne vide : la ligne porte sur le niveau au-dessus.
  annonceId String @default("")

  /// Le jour, dans le fuseau du compte.
  jour             DateTime @db.Date
  coutMicros       BigInt   @default(0)
  impressions      BigInt   @default(0)
  clics            BigInt   @default(0)
  /// Personnes distinctes atteintes. Meta le donne, Google non : 0 veut dire « la
  /// plateforme ne le dit pas ». La fréquence s'en déduit et n'est pas stockée — une valeur
  /// dérivée conservée finit par contredire celles dont elle vient.
  portee           BigInt   @default(0)
  /// Fractionnaire : Google compte au dixième quand les conversions sont pondérées.
  conversions      Float    @default(0)
  valeurConversion Float    @default(0)

  createdAt DateTime @default(now())

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  AdsAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campagne AdsCampagne @relation(fields: [campagneId], references: [id], onDelete: Cascade)

  @@unique([campagneId, groupeId, annonceId, jour], map: "AdsReleve_campagneId_groupeId_annonceId_jour_key")
  @@index([accountId, jour(sort: Desc)])
}

/// Ce que Naya propose. Conservé plutôt que recalculé : une recommandation ignorée doit le
/// rester, et une recommandation appliquée doit pouvoir être relue avec ses chiffres.
model AdsRecommandation {
  id         String  @id @default(uuid()) @db.Uuid
  userId     String  @db.Uuid
  accountId  String  @db.Uuid
  campagneId String? @db.Uuid

  /// Identifiant stable de la règle : ads.budget.limite, ads.roas.chute…
  regle       String
  /// urgent | surveiller | opportunite | information
  priorite    String @default("information")
  titre       String @default("")
  /// Ce qui a été constaté, écrit par le code et non par un modèle.
  observation String @default("")
  jours       Int    @default(0)
  /// Les chiffres qui la motivent : c'est ce qui rend l'avis contestable.
  donnees     Json   @default("{}")
  /// L'explication en français, écrite par Naya à partir de ces chiffres-là.
  explication String @default("")
  /// L'action proposée, sous une forme que le serveur sait exécuter. Jamais du texte libre.
  action      Json   @default("{}")

  /// campagne | ensemble | annonce — l'étage réellement visé.
  ///
  /// Chez Google, une recommandation porte sur une campagne. Chez Meta, le budget vit sur
  /// l'ensemble et la fatigue sur l'annonce : proposer une pause de campagne quand une seule
  /// annonce s'essouffle éteindrait aussi ce qui marche.
  niveau         String @default("campagne")
  /// Le nom de l'objet visé, tel qu'il s'affiche. Rafraîchi avec le reste du constat : le
  /// titre le porte déjà, et le figer ici ferait dire deux noms différents à la même ligne.
  cible          String @default("")
  /// Son identifiant interne. C'est lui que portera l'action, jamais le nom.
  cibleId        String @default("")
  /// Le mécanisme : pourquoi cela se produit. Écrit par le code, pas par un modèle.
  pourquoi       String @default("")
  /// Ce qu'il arrive si l'on ne fait rien. Jamais une promesse chiffrée.
  consequence    String @default("")
  /// Ce qu'on propose, en français. L'action exécutable reste dans `action`.
  recommandation String @default("")
  /// faible | moyen | eleve
  risque         String @default("faible")
  /// ouverte | appliquee | ignoree | perimee
  etat           String @default("ouverte")

  createdAt DateTime  @default(now())
  closedAt  DateTime?

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  AdsAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campagne AdsCampagne? @relation(fields: [campagneId], references: [id], onDelete: Cascade)
  actions  AdsAction[]

  @@index([accountId, etat])
}

/// Le journal, et la condition du retour arrière. Toute modification est écrite ici AVANT
/// d'être envoyée, avec sa valeur d'avant : sans cela, « restaurer 40 CHF » est un bouton
/// qui ment.
model AdsAction {
  id         String  @id @default(uuid()) @db.Uuid
  userId     String  @db.Uuid
  accountId  String  @db.Uuid
  campagneId String? @db.Uuid

  /// budget | pause | reprise | mot-cle-negatif…
  quoi             String
  motif            String  @default("")
  avant            Json    @default("{}")
  apres            Json    @default("{}")
  /// assiste | autopilote | restauration
  mode             String  @default("assiste")
  /// prevu | reussi | refuse — « prevu » est une écriture commencée et non confirmée.
  resultat         String  @default("prevu")
  /// Le refus de la plateforme, en clair et sans secret.
  detail           String  @default("")
  annuleId         String? @db.Uuid
  /// Le constat dont cette action est issue, quand elle vient d'une recommandation. Sans ce
  /// lien, le journal serait une suite de modifications sans motif.
  recommandationId String? @db.Uuid

  createdAt DateTime @default(now())

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  account        AdsAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campagne       AdsCampagne?       @relation(fields: [campagneId], references: [id], onDelete: SetNull)
  annule         AdsAction?         @relation("AdsActionAnnulee", fields: [annuleId], references: [id], onDelete: SetNull)
  annulees       AdsAction[]        @relation("AdsActionAnnulee")
  recommandation AdsRecommandation? @relation(fields: [recommandationId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt(sort: Desc)])
  @@index([campagneId, quoi])
  @@index([recommandationId])
}

/// Un mot-clé que Naya propose d'acheter, et ce qu'il coûterait.
///
/// Séparé des propositions de texte parce qu'il porte des chiffres qu'un titre n'a pas.
/// Search Console dit ce que la requête vaut déjà sans payer ; le planificateur de Google dit
/// ce qu'elle coûterait. Les deux ensemble font une décision ; l'un sans l'autre, une
/// intuition.
///
/// Les chiffres sont figés à la proposition : le planificateur consomme le quota d'API
/// partagé par tous les utilisateurs d'Evoliia, et rouvrir un écran ne doit pas le rappeler.
model AdsMotCle {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  accountId String @db.Uuid
  groupeId  String @db.Uuid

  texte          String
  /// phrase | exact. Jamais « large » : sur un petit budget, elle dépense ailleurs.
  correspondance String @default("phrase")

  /// Ce que Search Console sait de la requête sur le site. 0 : elle n'y figure pas.
  position    Float @default(0)
  impressions Int   @default(0)
  clics       Int   @default(0)

  /// Recherches mensuelles moyennes. 0 : le planificateur n'en donne pas, ce qui se dit.
  volume         Int    @default(0)
  /// La fourchette du coût par clic en haut de page, en micros de la devise du compte.
  coutBasMicros  BigInt @default(0)
  coutHautMicros BigInt @default(0)
  concurrence    String @default("")

  /// « fr », « de », « it »… lue sur la page qui sert la requête. Vide : inconnue.
  langue    String @default("")
  /// achat | comparaison | local | information. Vide pour les lignes d'avant ce champ.
  intention String @default("")

  motif     String @default("")
  /// proposee | deposee | ecartee
  etat      String @default("proposee")
  /// Le critère chez Google, écrit au dépôt. Sans lui, rien à retirer au retour arrière.
  critereId String @default("")

  createdAt DateTime  @default(now())
  closedAt  DateTime?

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  account AdsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupe  AdsGroupe  @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  @@unique([groupeId, texte, correspondance])
  @@index([groupeId, etat])
}

/// Ce qu'une campagne contiendra, écrit avant qu'un seul appel parte chez Google.
///
/// Une table, et non un objet qui ferait l'aller-retour par le navigateur. La différence est
/// une garantie : ce que la personne confirme à l'écran est exactement ce qui est écrit ici,
/// et le navigateur ne transmet qu'un identifiant. Faire circuler le plan reviendrait à
/// croire sur parole les textes, les mots-clés et le budget au moment de créer.
model AdsPlanCampagne {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  accountId String @db.Uuid

  nom           String
  /// Le budget quotidien, en micros de la devise du compte.
  budgetMicros  BigInt @default(0)
  /// L'enchère par clic du groupe. Manuelle : une stratégie automatique sur une campagne
  /// sans historique de conversion dépense d'abord pour apprendre.
  enchereMicros BigInt @default(0)
  /// La page d'arrivée. Vérifiée contre les domaines de la personne, jamais crue.
  urlFinale     String

  marcheGeo    String @default("")
  marcheNom    String @default("")
  /// profil | chiffres : le pays a-t-il été déclaré, ou déduit des affichages ? Une
  /// déduction se vérifie, une déclaration non — et l'écran doit pouvoir le dire.
  marcheSource String @default("")
  langueCode   String @default("")
  langueNom    String @default("")

  /// Les mots-clés retenus, avec leurs chiffres au moment du plan.
  motsCles     Json @default("[]")
  /// Google exige trois titres et deux descriptions au minimum, sans quoi il refuse
  /// l'annonce — et le groupe reste sans rien à diffuser.
  titres       Json @default("[]")
  descriptions Json @default("[]")

  /// prepare | cree | abandonne
  etat              String @default("prepare")
  /// Ce que Google a rendu : de quoi retrouver et supprimer ce qui a été créé.
  campagneRessource String @default("")
  budgetRessource   String @default("")

  createdAt DateTime  @default(now())
  closedAt  DateTime?

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  account AdsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, etat])
}
